<article class="result-card explore-card explore-card--collage<%= " explore-card--text" if collage.pictures.empty? %>">
  <% if collage.pictures.any? %>
    <%= link_to collage.path, class: "collage-card__pictures", tabindex: -1, "aria-hidden": true do %>
      <% collage.pictures.each do |picture| %><%= image_tag picture[:src], alt: "", loading: "lazy", decoding: "async" %><% end %>
    <% end %>
  <% end %>
  <div class="result-card__content">
    <h3 class="document-title-heading"><%= link_to collage.title, collage.path, class: "explore-card__link" %></h3>
    <% if collage.text.present? %><p class="explore-card__intro"><%= collage.text %></p><% end %>
  </div>
</article>
