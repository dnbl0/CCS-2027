<%# A slim bar fixed to the foot of the window (Dean, 26 Nov 2026): one sentence, the link to the cookie list, and the answer. Still
    placeholder wording (data-placeholder-wording), but the note saying so is not shown to visitors until the University approves it. %>
<section class="cookie-notice" aria-labelledby="cookie-notice-title" data-controller="cookie-notice" data-turbo-temporary data-placeholder-wording>
  <div class="cookie-notice__inner">
    <h2 class="visually-hidden" id="cookie-notice-title"><%= t("nexus_ccs.cookie_notice.title") %></h2>
    <p class="cookie-notice__text">
      <% if choosable? %>
        <%= t("nexus_ccs.cookie_notice.bar_with_choice") %>
        <%# each optional kind named, with what it is for, so the choice is an informed one %>
        <% optional.each do |category| %><strong><%= t("nexus_ccs.cookie_notice.optional.#{category.key}.name") %>:</strong> <%= t("nexus_ccs.cookie_notice.optional.#{category.key}.purpose") %> <% end %>
      <% else %>
        <%= t("nexus_ccs.cookie_notice.bar") %>
      <% end %>
      <%= link_to t("nexus_ccs.cookie_notice.bar_link"), helpers.privacy_path(anchor: "cookies"), class: "cookie-notice__link" %>
    </p>
    <%= helpers.form_with url: helpers.cookie_notice_path, method: :post, class: "cookie-notice__form", data: { turbo: false, action: "submit->cookie-notice#save" } do %>
      <div class="cookie-notice__actions">
        <% if choosable? %>
          <button type="submit" name="choice" value="declined" class="btn btn-primary btn-sm"><%= t("nexus_ccs.cookie_notice.decline") %></button>
          <button type="submit" name="choice" value="accepted" class="btn btn-primary btn-sm"><%= t("nexus_ccs.cookie_notice.accept") %></button>
        <% else %>
          <button type="submit" name="choice" value="acknowledged" class="btn btn-primary btn-sm"><%= t("nexus_ccs.cookie_notice.ok") %></button>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
