<%# The record page (components/record.css): a header in two columns (the title with its date, maker and collection, Associated
    names and the actions; the media on its grey panel), then sections each opened by a rule with the heading on the left: Object
    overview (the key facts), About this object (the description) and Record details and notes (an accordion). You may be interested
    in follows (catalog/show). %>
<%= content_tag @component,
  id: @id,
  data: { "document-id": document.id.to_s.parameterize },
  itemscope: true,
  itemtype: document.itemtype,
  class: "record" do %>
  <% if stepper? && (steps = stepper.to_s).strip.present? %>
    <div class="record__stepper"><%= steps %></div>
  <% end %>

  <div class="record__body">
    <%# Content warnings come before the media %>
    <% notices = capture do %>
      <%= render NexusCcs::CulturalProtocolsNoticeComponent.new(document: document) %>
      <%= render NexusCcs::DebiasNoticeComponent.new(matches: debias_matches, labels: debias_labels) %>
    <% end %>
    <% if notices.strip.present? %><div class="record__notices"><%= notices %></div><% end %>

    <div class="record__header">
      <div class="record__identity">
        <h1 class="record__title"><%= title_markup %></h1>
        <%# What identifies the object, kept together under the title: its date, its maker and the collection it belongs to %>
        <% collection = collection_link %>
        <% if display_date || makers.any? || collection %>
          <div class="record__lines">
            <% if display_date %><p><%= display_date %></p><% end %>
            <% if makers.any? %><p><%= makers.map(&:first).join("; ") %></p><% end %>
            <% if collection %>
              <p class="record__collection">
                <span><%= collection.first %></span>
                <% if collection.last %><%= link_to t("nexus_ccs.record_page.layout.see_collection"), collection.last, class: "arrow-link arrow-link--icon" %><% end %>
              </p>
            <% end %>
          </div>
        <% end %>
        <% if associated_names.any? %>
          <section class="record__names" aria-labelledby="record-names-heading">
            <h2 class="record__names-heading" id="record-names-heading"><%= t("nexus_ccs.record_page.layout.associated_names") %></h2>
            <ul class="record__name-list">
              <% associated_names.each do |name, path, detail| %>
                <li>
                  <% if path %><%= link_to name, path, class: "record__name ccs-text-link" %><% else %><span class="record__name"><%= name %></span><% end %>
                  <% if detail.present? %><span class="record__role"><%= detail %></span><% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
        <div class="record__actions"><%= render NexusCcs::RecordActionsComponent.new(document: document) %></div>
      </div>

      <div class="record__media">
        <% if assets? %>
          <%= render NexusCcs::DigitalAssetsComponent.new(presenter: @presenter) %>
        <% else %>
          <%= render NexusCcs::NoImageComponent.new(document: document, url: helpers.solr_document_url(document)) %>
        <% end %>
      </div>
    </div>

    <%# Object overview: the key facts of the data model sheet, two columns %>
    <section class="record__section" aria-labelledby="record-overview-heading">
      <h2 class="record__section-heading" id="record-overview-heading"><%= t("nexus_ccs.record_page.layout.overview") %></h2>
      <dl class="record__facts">
        <% overview_rows.each do |row| %>
          <div class="record__fact">
            <dt><%= row.label %></dt>
            <dd><%= fact_value(row) %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <% if lead %>
      <%# About this object: the description, three lines then Read more (CCS-413) %>
      <section class="record__section" aria-labelledby="record-about-object-heading">
        <h2 class="record__section-heading" id="record-about-object-heading"><%= t("nexus_ccs.record_page.layout.about_object") %></h2>
        <div class="record__description" data-controller="truncate"
             data-truncate-more-label-value="<%= t("nexus_ccs.record_page.showcase.read_more") %>" data-truncate-less-label-value="<%= t("nexus_ccs.record_page.showcase.read_less") %>">
          <div class="record__description-text record-fade" id="record-description" data-truncate-target="text">
            <p class="record__lead" data-truncate-target="lead"><%= lead %></p>
            <% description_rest.each do |paragraph| %><p data-truncate-target="more"><%= paragraph %></p><% end %>
          </div>
          <button type="button" class="record-read-more" aria-controls="record-description" aria-expanded="true"
                  data-truncate-target="toggle" data-action="truncate#toggle" hidden><%= t("nexus_ccs.record_page.showcase.read_more") %></button>
        </div>
      </section>
    <% end %>

    <%# Record details and notes: the design system's accordion, as native <details> (each opens without JavaScript) %>
    <section class="record__section" aria-labelledby="record-notes-heading">
      <h2 class="record__section-heading" id="record-notes-heading"><%= t("nexus_ccs.record_page.layout.notes") %></h2>
      <div class="record-accordion">
        <details class="record-accordion__item" id="object-details">
          <summary><h3 class="record-accordion__title" id="record-details-title"><%= t("nexus_ccs.record_page.layout.full_record") %></h3></summary>
          <div class="record-accordion__panel">
            <%# CCS-400: every field of the data model sheet the record has, in its sequence %>
            <%= render NexusCcs::RecordFactRowsComponent.new(rows: lead_rows + object_rows, record: self, id_row: true) %>
          </div>
        </details>
        <% if inscriptions.any? %>
          <details class="record-accordion__item" id="inscriptions">
            <summary><h3 class="record-accordion__title"><%= t("nexus_ccs.record_page.layout.inscriptions") %></h3></summary>
            <div class="record-accordion__panel"><% inscriptions.each do |text| %><p><%= text %></p><% end %></div>
          </details>
        <% end %>
        <details class="record-accordion__item" id="record-use">
          <summary><h3 class="record-accordion__title"><%= t("nexus_ccs.record_page.use.heading") %></h3></summary>
          <div class="record-accordion__panel record-use">
            <%# Use and access (CCS-27, 47, 67, 68, 69, 166) %>
            <ul class="record-use__status">
              <li class="record-use__state record-use__state--<%= can_view? ? "yes" : "no" %>"><span class="record-use__mark" aria-hidden="true"><%= can_view? ? "✓" : "–" %></span><span><%= view_status %></span></li>
              <% if assets? %>
                <li class="record-use__state record-use__state--<%= can_download? ? "yes" : "no" %>"><span class="record-use__mark" aria-hidden="true"><%= can_download? ? "✓" : "–" %></span><span><%= download_status %></span></li>
              <% end %>
            </ul>
            <% if sensitive? %><p class="record-use__note"><%= t("nexus_ccs.record_page.use.sensitive") %></p><% end %>
            <% if (note = t("nexus_ccs.record_page.use.note.#{access_state}", default: "")).present? %><p class="record-use__note"><%= note %></p><% end %>
            <% if rights_items.any? %>
              <dl class="record-accordion__list">
                <% rights_items.each do |label, value| %><div><dt><%= label %></dt><dd><%= value %></dd></div><% end %>
              </dl>
            <% else %>
              <p><%= t("nexus_ccs.rights.none_recorded") %></p>
            <% end %>
            <p><%= link_to t("nexus_ccs.record_page.copyright.terms"), terms_path %> <%= render NexusCcs::HelpTipComponent.new(topic: :copyright) %></p>
            <%= render NexusCcs::ContactCollectionComponent.new(document: document, url: helpers.solr_document_url(document)) %>
          </div>
        </details>
        <details class="record-accordion__item" id="how-to-cite">
          <summary><h3 class="record-accordion__title"><%= t("nexus_ccs.record_page.card.cite") %></h3></summary>
          <div class="record-accordion__panel"><%= render NexusCcs::CiteComponent.new(document: document, inline: true) %></div>
        </details>
        <details class="record-accordion__item" id="about-this-record">
          <summary><h3 class="record-accordion__title"><%= t("nexus_ccs.record_page.sections.about") %></h3></summary>
          <div class="record-accordion__panel"><%= render NexusCcs::RecordAboutComponent.new(document: document, url: helpers.solr_document_url(document), heading: false) %></div>
        </details>
      </div>
    </section>
  </div>

  <%= footer %>
<% end %>
