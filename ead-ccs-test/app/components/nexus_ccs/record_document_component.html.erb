<%# The record page, after the National Gallery of Art's artwork pages: a header in two columns (the title, date and maker, Associated
    names, the actions and the record's collection; the media on its grey panel), then sections each opened by a rule with the heading
    on the left: Object overview (the key facts), About this object (the description) and Record details & notes (folding sections).
    You may be interested in follows (catalog/show). %>
<%= content_tag @component,
  id: @id,
  data: { "document-id": document.id.to_s.parameterize },
  itemscope: true,
  itemtype: document.itemtype,
  class: "record record--nga" do %>
  <% if stepper? && (steps = stepper.to_s).strip.present? %>
    <div class="record-nga__stepper"><%= steps %></div>
  <% end %>

  <div class="record-nga">
    <%# Content warnings come before the media %>
    <% notices = capture do %>
      <%= render NexusCcs::CulturalProtocolsNoticeComponent.new(document: document) %>
      <%= render NexusCcs::DebiasNoticeComponent.new(matches: debias_matches, labels: debias_labels) %>
    <% end %>
    <% if notices.strip.present? %><div class="record-nga__notices"><%= notices %></div><% end %>

    <div class="record-nga__header">
      <div class="record-nga__identity">
        <h1 class="record-nga__title"><%= title_markup %></h1>
        <% if display_date || makers.any? %>
          <div class="record-nga__lines">
            <% if display_date %><p><%= display_date %></p><% end %>
            <% if makers.any? %><p><%= makers.map(&:first).join("; ") %></p><% end %>
          </div>
        <% end %>
        <% if associated_names.any? %>
          <section class="record-nga__names" aria-labelledby="record-names-heading">
            <h2 class="record-nga__names-heading" id="record-names-heading"><%= t("nexus_ccs.record_page.nga.associated_names") %></h2>
            <ul class="record-nga__name-list">
              <% associated_names.each do |name, path, detail| %>
                <li>
                  <% if path %><%= link_to name, path, class: "record-nga__name" %><% else %><span class="record-nga__name"><%= name %></span><% end %>
                  <% if detail.present? %><span class="record-nga__role"><%= detail %></span><% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
        <div class="record-nga__actions"><%= render NexusCcs::RecordActionsComponent.new(document: document) %></div>
        <% if (collection = collection_link) %>
          <%# Where the object is (NGA's "Not on view · See artworks now on view") %>
          <p class="record-nga__collection">
            <span><%= collection.first %></span>
            <% if collection.last %><%= link_to t("nexus_ccs.record_page.nga.see_collection"), collection.last, class: "record-arrow-link" %><% end %>
          </p>
        <% end %>
      </div>

      <div class="record-nga__media">
        <% if assets? %>
          <%= render NexusCcs::DigitalAssetsComponent.new(presenter: @presenter) %>
        <% else %>
          <%= render NexusCcs::NoImageComponent.new(document: document, url: helpers.solr_document_url(document)) %>
        <% end %>
      </div>
    </div>

    <%# Object overview (NGA's Artwork overview): the key facts of the data model sheet, two columns %>
    <section class="record-nga__section" aria-labelledby="record-overview-heading">
      <h2 class="record-nga__section-heading" id="record-overview-heading"><%= t("nexus_ccs.record_page.nga.overview") %></h2>
      <dl class="record-nga__facts">
        <% overview_rows.each do |row| %>
          <div class="record-nga__fact">
            <dt><%= row.label %></dt>
            <dd><%= fact_value(row) %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <% if lead %>
      <%# About this object (NGA's More About this Artwork): the description, three lines then Read more (CCS-413) %>
      <section class="record-nga__section" aria-labelledby="record-about-object-heading">
        <h2 class="record-nga__section-heading" id="record-about-object-heading"><%= t("nexus_ccs.record_page.nga.about_object") %></h2>
        <div class="record-nga__description" data-controller="truncate"
             data-truncate-more-label-value="<%= t("nexus_ccs.record_page.showcase.read_more") %>" data-truncate-less-label-value="<%= t("nexus_ccs.record_page.showcase.read_less") %>">
          <div class="record-nga__description-text record-fade" id="record-description" data-truncate-target="text">
            <p class="record-nga__lead" data-truncate-target="lead"><%= lead %></p>
            <% description_rest.each do |paragraph| %><p data-truncate-target="more"><%= paragraph %></p><% end %>
          </div>
          <button type="button" class="record-read-more" aria-controls="record-description" aria-expanded="true"
                  data-truncate-target="toggle" data-action="truncate#toggle" hidden><%= t("nexus_ccs.record_page.showcase.read_more") %></button>
        </div>
      </section>
    <% end %>

    <%# Record details & notes (NGA's Artwork history & notes): folding sections, the plus on the right %>
    <section class="record-nga__section" aria-labelledby="record-notes-heading">
      <h2 class="record-nga__section-heading" id="record-notes-heading"><%= t("nexus_ccs.record_page.nga.notes") %></h2>
      <div class="record-sections">
        <details class="record-section" id="object-details">
          <summary><h3 class="record-section__title" id="record-details-title"><%= t("nexus_ccs.record_page.nga.full_record") %></h3></summary>
          <div class="record-section__body">
            <%# CCS-400: every field of the data model sheet the record has, in its sequence %>
            <%= render NexusCcs::RecordFactRowsComponent.new(rows: lead_rows + object_rows, record: self, id_row: true) %>
          </div>
        </details>
        <% if inscriptions.any? %>
          <details class="record-section" id="inscriptions">
            <summary><h3 class="record-section__title"><%= t("nexus_ccs.record_page.nga.inscriptions") %></h3></summary>
            <div class="record-section__body"><% inscriptions.each do |text| %><p><%= text %></p><% end %></div>
          </details>
        <% end %>
        <details class="record-section" id="record-use">
          <summary><h3 class="record-section__title"><%= t("nexus_ccs.record_page.use.heading") %></h3></summary>
          <div class="record-section__body record-use">
            <%# Use and access (CCS-27, 47, 67, 68, 69, 166) %>
            <ul class="record-use__status">
              <li class="record-use__state record-use__state--<%= can_view? ? "yes" : "no" %>"><span class="record-use__mark" aria-hidden="true"><%= can_view? ? "✓" : "–" %></span><span><%= view_status %></span></li>
              <% if assets? %>
                <li class="record-use__state record-use__state--<%= can_download? ? "yes" : "no" %>"><span class="record-use__mark" aria-hidden="true"><%= can_download? ? "✓" : "–" %></span><span><%= download_status %></span></li>
              <% end %>
            </ul>
            <% if sensitive? %><p class="record-use__note"><%= t("nexus_ccs.record_page.use.sensitive") %></p><% end %>
            <% if (note = t("nexus_ccs.record_page.use.note.#{access_state}", default: "")).present? %><p class="record-use__note"><%= note %></p><% end %>
            <% if rights_items.any? %>
              <dl class="record-section__list">
                <% rights_items.each do |label, value| %><div><dt><%= label %></dt><dd><%= value %></dd></div><% end %>
              </dl>
            <% else %>
              <p><%= t("nexus_ccs.rights.none_recorded") %></p>
            <% end %>
            <p><%= link_to t("nexus_ccs.record_page.copyright.terms"), terms_path %> <%= render NexusCcs::HelpTipComponent.new(topic: :copyright) %></p>
            <%= render NexusCcs::ContactCollectionComponent.new(document: document, url: helpers.solr_document_url(document)) %>
          </div>
        </details>
        <details class="record-section" id="how-to-cite">
          <summary><h3 class="record-section__title"><%= t("nexus_ccs.record_page.card.cite") %></h3></summary>
          <div class="record-section__body"><%= render NexusCcs::CiteComponent.new(document: document, inline: true) %></div>
        </details>
        <details class="record-section" id="about-this-record">
          <summary><h3 class="record-section__title"><%= t("nexus_ccs.record_page.sections.about") %></h3></summary>
          <div class="record-section__body"><%= render NexusCcs::RecordAboutComponent.new(document: document, url: helpers.solr_document_url(document), heading: false) %></div>
        </details>
      </div>
    </section>
  </div>

  <%= footer %>
<% end %>
