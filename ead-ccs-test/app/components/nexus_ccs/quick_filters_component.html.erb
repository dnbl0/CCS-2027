<%# One row of one-tap filters (QuickFiltersComponent): a labelled list of links, each the search with one more filter %>
<nav class="quick-filters" aria-labelledby="quick-filters-heading">
  <h2 id="quick-filters-heading" class="quick-filters__heading"><%= t("nexus_ccs.quick_filters.heading") %></h2>
  <ul class="quick-filters__list">
    <% chips.each do |chip| %>
      <li>
        <%= link_to path(chip), class: "quick-filters__chip", title: field_label(chip) do %>
          <%= chip.label %>
          <span class="quick-filters__count"><%= number_with_delimiter(chip.item.hits) %><span class="visually-hidden"> <%= t("nexus_ccs.quick_filters.results", count: chip.item.hits) %></span></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
