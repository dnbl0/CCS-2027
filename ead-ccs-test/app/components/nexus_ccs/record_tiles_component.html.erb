<section id="<%= id %>" class="record-tiles" aria-labelledby="<%= id %>-heading">
  <div class="record-tiles__inner">
    <h2 id="<%= id %>-heading" class="record-tiles__heading"><%= heading %></h2>
    <ul class="record-tiles__list">
      <% documents.each do |document| %>
        <li class="record-tiles__item">
          <%= link_to helpers.solr_document_path(document), class: "record-tiles__link" do %>
            <% path = image_path(document) %>
            <span class="record-tiles__media<%= ' record-tiles__media--empty' unless path %>">
              <% if path %>
                <%# The link's text names the record, so the image adds nothing to it %>
                <%= image_tag path, alt: "", class: "record-tiles__image", loading: "lazy", decoding: "async", **image_size(path) %>
              <% end %>
            </span>
            <span class="record-tiles__title"><%= title(document) %></span>
            <% if meta(document).present? %>
              <span class="record-tiles__meta"><%= meta(document) %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
