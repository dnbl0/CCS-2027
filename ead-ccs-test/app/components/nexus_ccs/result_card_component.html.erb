<%= content_tag @component,
  id: @id,
  data: { "document-id": document.id.to_s.parameterize, "document-counter": counter }.merge(media? ? { controller: "image-fallback", image_fallback_remove_class_value: "result-card--media", image_fallback_add_class_value: "result-card--no-media" } : {}),
  itemscope: true,
  itemtype: document.itemtype,
  class: card_classes.join(" ") do %>
  <% if media? %>
    <%= link_to document_path, class: "result-card__media", tabindex: -1, "aria-hidden": true, data: { image_fallback_target: "media" } do %>
      <%= image_tag media_path, alt: "", loading: "lazy", decoding: "async", data: { action: "error->image-fallback#failed" }, **media_size %>
    <% end %>
  <% end %>
  <div class="result-card__content">
    <%= title %>
    <% if lines.any? %>
      <ul class="result-card__lines">
        <% line_fields.each do |field, line| %><li><%= line_html(field, line) %></li><% end %>
      </ul>
    <% end %>
    <%= render NexusCcs::MatchRationaleComponent.new(match: match, show_snippet: show_snippet?) %>
    <%= render NexusCcs::SelectBoxComponent.new(document_id: document.id, title: title_text) if selectable? %>
    <% if Rails.configuration.x.saved_records %>
      <div class="result-card__save">
        <%= render NexusCcs::SaveControlComponent.new(document: document) %>
        <%= render NexusCcs::AddToListComponent.new(document: document) %>
      </div>
    <% end %>
  </div>
<% end %>
