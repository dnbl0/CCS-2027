<div class="record-actions access-card" role="group" aria-label="<%= t("nexus_ccs.record_page.sections.actions") %>">
  <% if headline %>
    <p class="access-card__headline"><%= headline %></p>
  <% end %>
  <% if download? %>
    <a class="access-card__primary" href="<%= download_href %>" download aria-label="<%= t("nexus_ccs.record_page.access.download_label", title: title) %>"><%= t("nexus_ccs.record_page.access.download") %></a>
  <% elsif request? %>
    <a class="access-card__primary" href="<%= request_path %>"><%= t("nexus_ccs.access_notice.request.link") %></a>
  <% end %>
  <% if view_only? %>
    <%# Why it cannot be downloaded, and where to ask: plain text and a link, not a button %>
    <p class="access-card__reason access-notice--view-only"><%= t("nexus_ccs.access_notice.view_only.title") %>. <a class="access-notice__link" href="<%= request_path %>"><%= t("nexus_ccs.access_notice.view_only.link") %></a></p>
  <% end %>
  <div class="record-actions__row" style="--record-tiles: <%= saved_records? ? 4 : 3 %>">
    <% if saved_records? %>
      <div class="record-summary__save">
        <%= render NexusCcs::SaveControlComponent.new(document: document) %>
        <%= render NexusCcs::AddToListComponent.new(document: document) %>
      </div>
    <% end %>
    <%= render NexusCcs::CompareActionsComponent.new(document: document, images: compare? ? media.images.size : 0) %>
    <div class="record-summary__cite"><%= render NexusCcs::CiteComponent.new(document: document) %></div>
    <div class="record-summary__share"><%= render NexusCcs::ShareDialogComponent.new(kind: :record, document: document) %></div>
  </div>
  <%# The stable identifier (CCS-22): CCS has no global ID, so the collection, its accession number and the UoM ID, to quote %>
  <p class="record-summary__identifier" data-testid="record-identifier" data-controller="clipboard">
    <span class="record-summary__identifier-label"><%= t("nexus_ccs.record_page.header.collection_id") %></span>
    <span data-clipboard-target="source" data-copy="<%= identifier %>"><%= identifier %></span>
    <button type="button" class="record-copy" data-action="clipboard#copy" data-clipboard-target="button" aria-label="<%= t("nexus_ccs.record_page.header.copy_label") %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></svg>
      <span data-clipboard-target="label"><%= t("nexus_ccs.record_page.header.copy") %></span>
    </button>
    <span class="visually-hidden" role="status" data-clipboard-target="status"></span>
  </p>
</div>
