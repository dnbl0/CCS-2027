<div class="record-actions" role="group" aria-label="<%= t("nexus_ccs.record_page.split.actions") %>">
  <% if notice? %>
    <%= render NexusCcs::AccessNoticeComponent.new(document: document) %>
  <% end %>
  <div class="record-actions__row">
    <% if saved_records? %>
      <%= render NexusCcs::SaveControlComponent.new(document: document) %>
      <%= render NexusCcs::AddToListComponent.new(document: document) %>
    <% end %>
    <%= render NexusCcs::ShareDialogComponent.new(kind: :record, document: document) %>
    <%= render NexusCcs::CiteComponent.new(document: document) %>
  </div>
  <% if compare? %>
    <div class="record-actions__compare"><%= render NexusCcs::CompareActionsComponent.new(document: document, images: media.images.size) %></div>
  <% end %>
</div>
