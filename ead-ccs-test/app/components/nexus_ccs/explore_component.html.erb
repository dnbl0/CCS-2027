<section class="ccs-section explore" aria-labelledby="explore-title">
  <div class="ccs-section__inner explore__inner">
    <header class="explore__header">
      <h2 id="explore-title" class="ccs-section__heading">Explore the collections</h2>
      <p class="explore__intro">No search term needed. Start from what the records are, where they come from or when they were made.</p>
    </header>
    <div class="explore__groups">
      <% groups.each do |group| %>
        <div class="explore__group">
          <% if image?(group) %>
            <%# The caption is the link text, so the picture itself is decorative (empty alt) %>
            <figure class="explore__figure">
              <%= link_to image_record_path(group), class: "explore__figure-link" do %>
                <span class="explore__frame"><%= image_tag image_path(group), alt: "", width: group.image.width, height: group.image.height, loading: "lazy", decoding: "async", class: "explore__image" %></span>
                <figcaption class="explore__caption"><%= group.image.title %></figcaption>
              <% end %>
            </figure>
          <% end %>
          <h3 id="<%= heading_id(group) %>" class="explore__heading"><%= group.heading %></h3>
          <ul class="explore__list" aria-labelledby="<%= heading_id(group) %>">
            <% group.items.each do |item| %>
              <li class="explore__item">
                <%= link_to helpers.search_action_path(item.query), class: "explore__link" do %>
                  <span class="explore__label"><%= item.label.to_s.upcase_first %></span>
                  <span class="explore__count"><%= count_label(item.count) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
          <%= link_to helpers.browse_hub_path(hub_slug(group)), class: "arrow-link arrow-link--icon explore__all" do %><%= see_all_label(group) %><% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
