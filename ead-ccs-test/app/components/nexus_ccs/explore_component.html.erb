<section class="ccs-section explore" aria-labelledby="explore-title">
  <div class="ccs-section__inner explore__inner">
    <header class="explore__header">
      <h2 id="explore-title" class="ccs-section__heading"><%= t("explore.title") %></h2>
      <p class="explore__intro"><%= t("explore.intro") %></p>
    </header>

    <% if overview.collections.any? %>
      <ul id="browse-collections" class="explore__tiles<%= " explore__tiles--all" if overview.collections.size > 6 %>" aria-label="<%= t("explore.collections.label") %>">
        <% overview.collections.each do |tile| %>
          <li class="explore__tile explore__tile--tint-<%= tile.tint %>">
            <%= link_to helpers.search_action_path(tile.query), class: "explore__tile-link" do %>
              <% if image?(tile) %>
                <%# The title is the link text, so the picture itself is decorative (empty alt) %>
                <span class="explore__face explore__face--image"><%= image_tag image_path(tile), alt: "", width: tile.image.width, height: tile.image.height, loading: "lazy", decoding: "async", class: "explore__image" %></span>
              <% else %>
                <span class="explore__face" aria-hidden="true"><span class="explore__monogram"><%= monogram(tile) %></span></span>
              <% end %>
              <span class="explore__tile-body">
                <h3 class="explore__tile-title"><%= tile.label %></h3>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>

<%# Record types, Places and Time: each its own section (the page's sections alternate white and grey), its tiles the site's result cards in the mosaic %>
<% [ [ :kinds, overview.kind_tiles, t("explore.kinds.heading"), t("explore.kinds.see_all"), "object-types" ],
     [ :places, overview.place_tiles, t("explore.place_time.places"), t("explore.place_time.see_all_places"), "places" ],
     [ :periods, overview.period_tiles, t("explore.place_time.periods"), t("explore.place_time.see_all_periods"), "periods" ] ].each do |key, tiles, heading, see_all, slug| %>
  <% next if tiles.empty? %>
  <section class="ccs-section explore-<%= key %>" aria-labelledby="explore-<%= key %>">
    <div class="ccs-section__inner explore__inner">
      <header class="explore__row-head">
        <h2 id="explore-<%= key %>" class="ccs-section__heading"><%= heading %></h2>
        <%= link_to see_all, helpers.browse_hub_path(slug), class: "arrow-link arrow-link--icon explore__all" %>
      </header>
      <div class="ccs-mosaic ccs-mosaic--4">
        <ul class="discover-cards">
          <% tiles.each do |tile| %>
            <li class="discover-cards__item"><%= render NexusCcs::ExploreCardComponent.new(tile: tile) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>
<% end %>
