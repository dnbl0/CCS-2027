<footer class="site-footer" aria-label="<%= t("nexus_ccs.footer.label") %>">
  <div class="site-footer__acknowledgement">
    <div class="site-footer__inner">
      <div>
        <h2><%= t("nexus_ccs.footer.acknowledgement_heading") %></h2>
        <div class="site-footer__flags">
          <%= image_tag "site/flag-aboriginal.svg", alt: t("nexus_ccs.footer.aboriginal_flag") %>
          <%= image_tag "site/flag-torres-strait.svg", alt: t("nexus_ccs.footer.torres_strait_flag") %>
        </div>
      </div>
      <div>
        <p><%= t("nexus_ccs.footer.acknowledgement") %></p>
        <%= link_to "https://www.unimelb.edu.au/reconciliation", class: "arrow-link arrow-link--inverse" do %>
          <%= image_tag "site/icon-arrow-footer.svg", alt: "" %><%= t("nexus_ccs.footer.indigenous_priorities") %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="site-footer__main">
    <div class="site-footer__inner">
      <ul class="site-footer__links">
        <li><%= link_to helpers.browse_path, class: "arrow-link arrow-link--inverse" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %><%= t("browse.footer_link") %><% end %></li>
        <% about_links.each do |link| %>
          <li><%= link_to link.href, class: "arrow-link arrow-link--inverse" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %><%= link.label %><% end %></li>
        <% end %>
        <% site_links.each do |link| %>
          <li><%= link_to link.href, class: "arrow-link arrow-link--inverse" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %><%= link.label %><% end %></li>
        <% end %>
      </ul>

      <div class="site-footer__contact">
        <h2 class="site-footer__label"><%= t("nexus_ccs.footer.contact_heading") %></h2>
        <p><%= t("nexus_ccs.footer.phone") %> <a href="tel:136352">13 MELB (13 6352)</a><br><%= t("nexus_ccs.footer.international") %> <a href="tel:+61390355511">+61 3 9035 5511</a></p>
        <address><strong><%= t("nexus_ccs.footer.address") %></strong><br>The University of Melbourne<br>Grattan Street, Parkville<br>Victoria 3010<br>Australia</address>
      </div>

      <div>
        <h2 class="site-footer__label"><%= t("nexus_ccs.footer.connect_heading") %></h2>
        <ul class="site-footer__social">
          <% social_links.each do |label, href, icon| %>
            <li><%= link_to href, aria: { label: label } do %><%= image_tag icon, alt: "" %><% end %></li>
          <% end %>
        </ul>
      </div>

      <div class="site-footer__brand">
        <a href="https://www.unimelb.edu.au" aria-label="<%= t("nexus_ccs.footer.homepage") %>"><%= image_tag "site/uom-logo-vert-ondark.svg", alt: "" %></a>
      </div>
    </div>
  </div>

  <div class="site-footer__legal-bar">
    <div class="site-footer__inner">
      <ul class="site-footer__legal">
        <% legal_links.each do |link| %>
          <li><%= link_to link.label, link.href %></li>
        <% end %>
      </ul>
      <ul class="site-footer__identifiers">
        <% identifiers.each do |label, value| %>
          <li><%= label %> <strong><%= value %></strong></li>
        <% end %>
      </ul>
    </div>
  </div>
</footer>
