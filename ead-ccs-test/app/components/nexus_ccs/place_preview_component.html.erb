<div class="place-preview" data-controller="place-preview">
  <ul class="place-preview__list" aria-label="<%= label %>">
    <% collages.each_with_index do |place, index| %>
      <li>
        <%= link_to place.path, class: "place-row", aria: { current: (index.zero? ? "true" : nil) },
                    data: { place_preview_target: "row", index: index, action: "mouseenter->place-preview#show focus->place-preview#show" } do %>
          <span class="place-row__thumb"><% if (first = place.pictures.first) %><%= image_tag first[:src], alt: "", loading: "lazy", decoding: "async" %><% end %></span>
          <span class="place-row__body">
            <span class="place-row__name"><%= place.title %></span>
            <% if place.text %><span class="place-row__count"><%= place.text %></span><% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <div class="place-preview__panels" aria-hidden="true">
    <% collages.each_with_index do |place, index| %>
      <div class="place-preview__panel" data-place-preview-target="panel" <%= "hidden" unless index.zero? %>>
        <div class="place-collage">
          <% place.pictures.each do |picture| %><%= image_tag picture[:src], alt: "", class: "place-collage__picture", loading: "lazy", decoding: "async" %><% end %>
        </div>
        <p class="place-preview__name"><%= place.title %></p>
      </div>
    <% end %>
  </div>
</div>
