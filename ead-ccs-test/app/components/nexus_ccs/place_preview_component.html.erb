<div class="place-preview" data-controller="place-preview">
  <ul class="place-preview__list" aria-label="<%= label %>">
    <% tiles.each_with_index do |tile, index| %>
      <li>
        <%= link_to path(tile), class: "place-row", aria: { current: (index.zero? ? "true" : nil) },
                    data: { place_preview_target: "row", index: index, action: "mouseenter->place-preview#show focus->place-preview#show" } do %>
          <span class="place-row__thumb"><% if image?(tile) %><%= image_tag image_path(tile), alt: "", loading: "lazy", decoding: "async" %><% end %></span>
          <span class="place-row__body">
            <span class="place-row__name"><%= tile.label %></span>
            <span class="place-row__count"><%= count_label(tile) %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%# The preview repeats what the list's links say, so it is hidden from assistive technology; the list is the way in %>
  <div class="place-preview__panels" aria-hidden="true">
    <% tiles.each_with_index do |tile, index| %>
      <div class="place-preview__panel" data-place-preview-target="panel" <%= "hidden" unless index.zero? %>>
        <% if image?(tile) %><%= image_tag image_path(tile), alt: "", class: "place-preview__image", loading: "lazy", decoding: "async" %><% end %>
        <div class="place-preview__caption">
          <p class="place-preview__name"><%= tile.label %></p>
          <% if tile.intro.present? %><p class="place-preview__text"><%= tile.intro %></p><% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
