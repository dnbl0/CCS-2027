<section class="ccs-section <%= id %>" aria-labelledby="<%= id %>">
  <div class="ccs-section__inner explore__inner">
    <%# The heading and intro are centred over the cards; "See all" follows them (components/card_tiles.css) %>
    <header class="explore__row-head">
      <h2 id="<%= id %>" class="ccs-section__heading"><%= heading %></h2>
    </header>
    <% if intro.present? %><p class="explore__intro"><%= intro %></p><% end %>
    <%= content %>
    <p class="card-section__more"><%= link_to see_all, see_all_path, class: "arrow-link arrow-link--icon explore__all" %></p>
  </div>
</section>
