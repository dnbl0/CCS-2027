<section id="digital-assets" class="digital-assets" data-controller="media-viewer" aria-labelledby="digital-assets-heading">
  <h2 id="digital-assets-heading" class="visually-hidden">Digital <%= "asset".pluralize(count + media.size) %></h2>

  <%# The image sits on the page, whole, at its own shape: the width and height attributes hold its space while it loads (a flat tint,
      never a tall dark band). Dark only in full screen and in the zoom viewer. %>
  <div class="digital-assets__stage" data-media-viewer-target="stage">
    <div class="digital-assets__media-area">
      <% if withheld? %>
        <%= render NexusCcs::AccessNoticeComponent.new(document: @document) %>
      <% end %>
      <% if gated? %>
        <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: sensitivity_state) %>
      <% end %>
      <% if main %>
        <figure class="digital-assets__main">
          <%= image_tag main.first, alt: alt(1), class: "digital-assets__image", data: { media_viewer_target: "image" },
                fetchpriority: "high", decoding: "async", **image_size(main.first) %>
          <%= render NexusCcs::DeepZoomComponent.new(sources: zoom_sources, label: alt(1)) %>
        </figure>
      <% end %>

      <% media.each do |item| %>
        <figure class="digital-assets__media">
          <%# Each kind of file has its viewer (MediaTypes): one that cannot be previewed says so %>
          <%= helpers.render partial: MediaTypes.viewer_for(item[:kind]), locals: { item: item, title: media_title(item), downloadable: downloadable? } %>
          <figcaption><%= media_title(item) %></figcaption>
        </figure>
      <% end %>
    </div>

    <% if sensitivity_state == :viewing %>
      <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: :viewing) %>
    <% end %>
  </div>

  <% if others.any? %>
    <ul class="digital-assets__others">
      <% others.each_with_index do |(large, thumbnail), index| %>
        <li>
          <% if downloadable? %>
            <%= link_to large, class: "digital-assets__other", target: "_blank", rel: "noopener",
                  data: { action: "media-viewer#show", media_viewer_large: large, media_viewer_alt: alt(index + 2) } do %>
              <%= image_tag thumbnail, alt: "#{alt(index + 2)} (opens full size in a new tab)", loading: "lazy", decoding: "async" %>
            <% end %>
          <% else %>
            <%# No link to the file: the thumbnail only changes the image on show %>
            <button type="button" class="digital-assets__other" data-action="media-viewer#show" data-media-viewer-large="<%= large %>" data-media-viewer-alt="<%= alt(index + 2) %>">
              <%= image_tag thumbnail, alt: alt(index + 2), loading: "lazy", decoding: "async" %>
            </button>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%# One slim toolbar directly under the image: what the visitor may do (chip) and under what licence on the left, the media tools
      (with text labels) and the one primary action on the right %>
  <div class="digital-assets__toolbar">
    <div class="digital-assets__toolbar-inner">
      <div class="digital-assets__chips">
        <p class="digital-assets__access digital-assets__access--<%= tier.to_s.dasherize %>" data-testid="access-chip"><%= access_chip %></p>
        <% if licence %>
          <p class="digital-assets__licence"><%= icon("media-copyright") %><span><span class="visually-hidden">Licence: </span><%= licence %></span></p>
        <% end %>
      </div>
      <div class="digital-assets__controls">
        <% if metadata? %>
          <button type="button" class="digital-assets__button" aria-controls="media-metadata" aria-expanded="false"
                  data-media-viewer-target="infoButton" data-action="media-viewer#togglePanel"><%= icon("media-info") %><span><%= t("nexus_ccs.record_page.media.information") %></span></button>
        <% end %>
        <% if assets_shown? && main %>
          <button type="button" class="digital-assets__button" hidden
                  data-media-viewer-target="fullscreenButton" data-action="media-viewer#toggleFullscreen"
                  data-label-on="<%= t("nexus_ccs.record_page.media.exit_full_screen") %>" data-label-off="<%= t("nexus_ccs.record_page.media.full_screen") %>"><%= icon("media-fullscreen") %><span data-media-viewer-target="fullscreenLabel"><%= t("nexus_ccs.record_page.media.full_screen") %></span></button>
        <% end %>
        <% if download_href %>
          <a class="digital-assets__primary" href="<%= download_href %>" download aria-label="<%= t("nexus_ccs.record_page.access.download_label", title: title) %>"><%= t("nexus_ccs.record_page.access.download") %></a>
        <% end %>
      </div>
    </div>
  </div>

  <% if metadata? %>
    <aside id="media-metadata" class="digital-assets__panel" aria-labelledby="media-metadata-heading" aria-hidden="true" data-media-viewer-target="panel">
      <div class="digital-assets__panel-head">
        <h3 id="media-metadata-heading" class="digital-assets__panel-title">Media metadata</h3>
        <button type="button" class="digital-assets__button" data-action="media-viewer#closePanel"><span><%= t("nexus_ccs.record_page.media.close_information") %></span></button>
      </div>
      <dl class="digital-assets__list">
        <% metadata.each do |label, text| %>
          <div class="digital-assets__item">
            <dt><%= label %></dt>
            <dd><%= text %></dd>
          </div>
        <% end %>
      </dl>
    </aside>
  <% end %>
</section>
