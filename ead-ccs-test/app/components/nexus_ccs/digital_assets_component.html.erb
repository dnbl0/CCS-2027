<%# The record's media (after the National Gallery of Art's artwork pages): the image whole on a light grey panel, the other images
    as small thumbnails under it, and along the panel's foot round Zoom and Download buttons with Media information at the end.
    Zoom opens the image full screen in a modal (deep zoom: zoom in, zoom out, rotate, reset, and previous and next when there are
    several images); Media information opens a drawer from the right (CCS-422). Under the panel, one line on the licence and what
    the visitor may do with the image. What it shows follows AccessPolicy asset by asset (see the class). Behaviour:
    controllers/media_viewer_controller.js and deep_zoom_controller.js; without JavaScript the image, the thumbnails (links to each
    open image) and the download are still there, and the script-only controls never appear. %>
<section id="digital-assets" class="digital-assets media-viewer" aria-labelledby="digital-assets-heading"
         data-controller="media-viewer"
         data-media-viewer-labels-value="<%= viewer_labels.to_json %>"
         data-action="deep-zoom:state->media-viewer#zoomChanged keydown->media-viewer#keydown">
  <h2 id="digital-assets-heading" class="visually-hidden">Digital <%= "asset".pluralize(count + media.size) %></h2>

  <div class="media-viewer__panel">
    <div class="media-viewer__stage digital-assets__stage">
      <% if withheld? %>
        <%= render NexusCcs::AccessNoticeComponent.new(document: @document) %>
      <% end %>
      <% if gated? %>
        <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: sensitivity_state) %>
      <% end %>
      <% if main %>
        <%# The image fitted whole into the panel and never upscaled; its width and height attributes hold its space while it loads %>
        <figure class="digital-assets__main">
          <%= image_tag main.first, alt: alt(1), class: "digital-assets__image", data: { media_viewer_target: "image" },
                fetchpriority: "high", decoding: "async", **image_size(main.first) %>
        </figure>
      <% elsif media.any? %>
        <% media.each do |item| %>
          <figure class="digital-assets__media">
            <%# Each kind of file has its viewer (MediaTypes): one that cannot be previewed, or played by a browser, says so %>
            <%= helpers.render partial: MediaTypes.viewer_for_item(item), locals: { item: item, title: media_title(item), downloadable: item[:downloadable], request_path: request_path } %>
            <figcaption><%= media_title(item) %></figcaption>
          </figure>
        <% end %>
      <% end %>
      <% if sensitivity_state == :viewing %>
        <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: :viewing) %>
      <% end %>
    </div>

    <% if images.size > 1 %>
      <%# The other images: small thumbnails, the one on show marked. Without JavaScript a thumbnail of an open image links to its file. %>
      <nav class="media-viewer__thumbs" aria-label="<%= t("#{VIEWER}.thumbnails") %>">
        <ol class="media-viewer__thumb-list">
          <% images.each_with_index do |(large, thumbnail), index| %>
            <li>
              <% label = t("#{VIEWER}.show_image", position: index + 1, count: images.size) %>
              <% attrs = { class: "digital-assets__thumb", aria: { current: (index.zero? ? "true" : nil), label: label },
                           data: { action: "media-viewer#show", media_viewer_target: "thumb", media_viewer_large: large, media_viewer_alt: alt(index + 1), media_viewer_position: index + 1 } } %>
              <%= content_tag(image_downloadable?(index) ? :a : :button, **attrs, **(image_downloadable?(index) ? { href: large, target: "_blank", rel: "noopener" } : { type: "button" })) do %>
                <%= image_tag thumbnail, alt: "", loading: "lazy", decoding: "async", class: "digital-assets__thumb-image" %>
              <% end %>
            </li>
          <% end %>
        </ol>
        <%# Which image is on show (the benchmark's "Image 1 of 12"); the script keeps it in step %>
        <p class="media-viewer__counter" data-media-viewer-target="counter"><%= t("#{VIEWER}.position", position: 1, count: images.size) %></p>
      </nav>
    <% end %>

    <% if (assets_shown? && main) || download_href || metadata.any? || manifest_url %>
      <%# The panel's foot: round Zoom and Download on the left, Media information on the right %>
      <div class="media-viewer__controls">
        <div class="media-viewer__controls-start">
          <% if assets_shown? && main %>
            <button type="button" class="round-control" hidden aria-haspopup="dialog" data-media-viewer-target="zoomButton" data-action="media-viewer#openZoom"
                    aria-label="<%= t("#{VIEWER}.open_zoom") %>" title="<%= t("#{VIEWER}.open_zoom") %>"><%= icon(:zoom_in) %></button>
          <% end %>
          <% if download_href %>
            <%# CCS-67: the essential information (caption and licence) first, to copy, then the download %>
            <div class="digital-assets__download" data-controller="dialog">
              <button type="button" class="round-control" aria-haspopup="dialog" data-action="dialog#open"
                      aria-label="<%= t("nexus_ccs.record_page.access.download_label", title: title) %>" title="<%= t("nexus_ccs.record_page.access.download") %>"><%= icon(:download) %></button>
              <dialog class="modal uom-dialog uom-modal digital-assets__download-dialog" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop" aria-labelledby="download-dialog-title">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                  <div class="modal-content">
                    <button type="button" class="modal-close" data-action="dialog#close"><%= t("nexus_ccs.record_page.download.close") %></button>
                    <div class="modal-header"><h2 class="modal-title h5" id="download-dialog-title"><%= t("#{VIEWER}.download_heading") %></h2></div>
                    <div class="modal-body">
                      <% options = download_options %>
                      <p><%= t(options.size > 1 ? "#{VIEWER}.download_intro" : "#{VIEWER}.download_one") %></p>
                      <% if options.size > 1 %>
                        <%# Figma's UoM Radio group: one per size the image service can draw, never larger than the image %>
                        <fieldset class="digital-assets__sizes" aria-describedby="download-size-hint">
                          <legend class="digital-assets__sizes-legend"><%= t("#{VIEWER}.size_legend") %></legend>
                          <p class="digital-assets__sizes-hint" id="download-size-hint"><%= t("#{VIEWER}.size_hint") %></p>
                          <% options.each do |key, label, href| %>
                            <div class="form-check">
                              <input class="form-check-input" type="radio" name="download-size" id="download-size-<%= key %>" value="<%= href %>"
                                     <%= "checked" if key == default_download.first %> data-action="change->media-viewer#chooseSize">
                              <label class="form-check-label" for="download-size-<%= key %>"><%= label %></label>
                            </div>
                          <% end %>
                        </fieldset>
                      <% elsif options.any? %>
                        <p class="digital-assets__size-one"><%= options.first[1] %></p>
                      <% end %>
                      <%# CCS-67: the essential information to copy with the image %>
                      <div class="digital-assets__essential-box" data-controller="clipboard">
                        <dl class="digital-assets__essential">
                          <% if essential_caption %><div><dt><%= t("nexus_ccs.record_page.download.caption") %></dt><dd><%= essential_caption %></dd></div><% end %>
                          <% if licence %><div><dt><%= t("nexus_ccs.record_page.download.licence") %></dt><dd><%= licence %></dd></div><% end %>
                        </dl>
                        <span hidden data-clipboard-target="source" data-copy="<%= essential_text %>"></span>
                        <button type="button" class="btn btn-outline-primary" data-action="clipboard#copy" data-clipboard-target="button"><span data-clipboard-target="label"><%= t("#{VIEWER}.copy_information") %></span></button>
                        <p class="visually-hidden" role="status" data-clipboard-target="status"></p>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-primary" data-action="dialog#close"><%= t("#{VIEWER}.cancel") %></button>
                      <a class="btn btn-primary" href="<%= default_download&.last || download_href %>" download data-media-viewer-target="downloadLink"><%= t("#{VIEWER}.download_image") %></a>
                    </div>
                  </div>
                </div>
              </dialog>
            </div>
          <% end %>
        </div>
        <div class="media-viewer__controls-end">
        <% if manifest_url %>
          <%# Figma Record/IIIF reuse: the manifest to copy, and viewers that open it %>
          <div class="digital-assets__iiif" data-controller="dialog">
            <button type="button" class="media-viewer__info-button media-viewer__iiif-button" aria-haspopup="dialog" data-action="dialog#open">
              <span class="media-viewer__iiif-mark" aria-hidden="true">IIIF</span><span><%= t("#{VIEWER}.iiif_button") %></span>
            </button>
            <dialog class="modal uom-dialog uom-modal digital-assets__iiif-dialog" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop" aria-labelledby="iiif-dialog-title">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <button type="button" class="modal-close" data-action="dialog#close"><%= t("nexus_ccs.record_page.download.close") %></button>
                  <div class="modal-header"><h2 class="modal-title h5" id="iiif-dialog-title"><%= t("#{VIEWER}.iiif_heading") %></h2></div>
                  <div class="modal-body" data-controller="clipboard">
                    <p><%= t("#{VIEWER}.iiif_intro") %></p>
                    <label class="visually-hidden" for="iiif-manifest-link"><%= t("#{VIEWER}.iiif_manifest_label") %></label>
                    <input type="text" class="form-control digital-assets__manifest" id="iiif-manifest-link" value="<%= manifest_url %>" readonly autocomplete="off" data-clipboard-target="source">
                    <button type="button" class="btn btn-outline-primary digital-assets__copy-manifest" data-action="clipboard#copy" data-clipboard-target="button"><span data-clipboard-target="label"><%= t("#{VIEWER}.copy_manifest") %></span></button>
                    <p class="visually-hidden" role="status" data-clipboard-target="status"></p>
                    <ul class="digital-assets__iiif-links">
                      <% iiif_links.each do |key, href| %>
                        <li><a href="<%= href %>" target="_blank" rel="noopener"><%= t("#{VIEWER}.#{key}") %><span class="visually-hidden"> <%= t("#{VIEWER}.new_tab") %></span><%= glyph(:external) %></a></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </dialog>
          </div>
        <% end %>
        <% if metadata.any? %>
          <button type="button" class="media-viewer__info-button" aria-haspopup="dialog" aria-controls="media-information" data-media-viewer-target="infoButton" data-action="media-viewer#openInfo">
            <%= glyph(:info) %><span><%= t("#{VIEWER}.media_information") %></span>
          </button>
        <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Under the panel, as NGA's line on image use: the licence and what the visitor may do, with the way to Use and access %>
  <p class="media-viewer__licence">
    <% if licence %><span class="media-viewer__licence-mark" aria-hidden="true"><%= glyph(:creative_commons) %></span><% end %>
    <span><%= licence_sentence %></span>
    <% if (state = request_state) %>
      <%# CCS-68, CCS-69: how to ask for the image (NGA's "Contact us about image usage") %>
      <a class="record-arrow-link" href="<%= request_path %>"><%= t("nexus_ccs.record_page.use.request.#{state}") %></a>
    <% else %>
      <a class="record-arrow-link" href="#record-use" data-controller="open-details" data-action="open-details#open"><%= t("#{VIEWER}.use_link") %></a>
    <% end %>
  </p>

  <% if main && media.any? %>
    <%# Audio, video and PDF files of a record that also has images: under the panel %>
    <div class="media-viewer__media">
      <% media.each do |item| %>
        <figure class="digital-assets__media">
          <%= helpers.render partial: MediaTypes.viewer_for_item(item), locals: { item: item, title: media_title(item), downloadable: item[:downloadable], request_path: request_path } %>
          <figcaption><%= media_title(item) %></figcaption>
        </figure>
      <% end %>
    </div>
  <% end %>

  <% if withheld_count.positive? %>
    <%# Some assets are withheld while these are shown (AccessPolicy.withheld_assets): said in plain words, with the request link.
        Static text, there when the page loads, so no live region. PLACEHOLDER WORDING (config/locales/record_page.en.yml). %>
    <div class="access-notice access-notice--partly-withheld">
      <p class="access-notice__body"><%= t("nexus_ccs.record_page.media.partly_withheld.body", count: withheld_count) %></p>
      <p class="access-notice__action"><a class="access-notice__link" href="<%= request_path %>"><%= t("nexus_ccs.record_page.media.partly_withheld.link", count: withheld_count) %></a></p>
    </div>
  <% end %>

  <% if assets_shown? && main %>
    <%# Zoom (NGA's zoom modal): the image full screen, zoom and rotate at the bottom left, close at the top right; Escape closes and
        focus returns to Zoom. The viewer loads on first use (deep_zoom_controller). %>
    <dialog class="media-zoom" aria-labelledby="media-zoom-heading" data-media-viewer-target="zoomDialog" data-action="close->media-viewer#zoomClosed">
      <%# Figma Record/IIIF zoom: the title and which image, top left, on the dark neutral ground %>
      <div class="media-zoom__caption">
        <h2 class="media-zoom__title" id="media-zoom-heading"><span class="visually-hidden"><%= t("#{VIEWER}.zoom_heading", title: "") %></span><%= title %></h2>
        <% if images.size > 1 %><p class="media-zoom__position" data-media-viewer-target="position"><%= t("#{VIEWER}.position", position: 1, count: images.size) %></p><% end %>
      </div>
      <%= render NexusCcs::DeepZoomComponent.new(sources: zoom_sources, label: alt(1)) %>
      <button type="button" class="round-control media-zoom__close" data-action="media-viewer#closeZoom"
              aria-label="<%= t("#{VIEWER}.close_zoom") %>" title="<%= t("#{VIEWER}.close_zoom") %>"><%= icon(:close) %></button>
      <div class="media-zoom__tools" role="group" aria-label="<%= t("#{VIEWER}.tools") %>">
        <%= control(:zoom_in, "zoomIn") %>
        <%= control(:zoom_out, "zoomOut", disabled: true) %>
        <%= control(:rotate_right, "rotateRight") %>
        <%= control(:reset_zoom, "reset", disabled: true) %>
        <% if images.size > 1 %>
          <span class="media-zoom__divider" aria-hidden="true"></span>
          <%= control(:previous, "previous", disabled: true) %>
          <%= control(:next, "next") %>
        <% end %>
      </div>
      <p class="media-zoom__readout" role="status" aria-live="polite" data-media-viewer-target="readout"></p>
    </dialog>
  <% end %>

  <% if metadata.any? %>
    <%# CCS-422: the media information, a drawer from the right (NGA's Visual Description); Escape or Close returns focus %>
    <dialog id="media-information" class="media-drawer" aria-labelledby="media-information-heading" data-media-viewer-target="infoDialog" data-action="click->media-viewer#closeInfoOnBackdrop">
      <div class="media-drawer__inner">
        <div class="media-drawer__head">
          <h2 id="media-information-heading" class="media-drawer__heading"><%= t("#{VIEWER}.media_information") %></h2>
          <button type="button" class="round-control" data-action="media-viewer#closeInfo" aria-label="<%= t("#{VIEWER}.close_information") %>" title="<%= t("#{VIEWER}.close_information") %>"><%= icon(:close) %></button>
        </div>
        <dl class="media-drawer__fields">
          <% metadata.each do |label, text| %><div class="media-drawer__field"><dt><%= label %></dt><dd><%= text %></dd></div><% end %>
        </dl>
      </div>
    </dialog>
  <% end %>

  <%# Announces what the controls did (image shown, rotation), politely, without moving focus %>
  <p class="visually-hidden" role="status" aria-live="polite" data-media-viewer-target="status"></p>
</section>
