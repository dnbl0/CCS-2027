<section id="digital-assets" class="digital-assets" data-controller="media-viewer" aria-labelledby="digital-assets-heading">
  <h2 id="digital-assets-heading" class="visually-hidden">Digital <%= "asset".pluralize(count + media.size) %></h2>

  <div class="digital-assets__stage" data-media-viewer-target="stage">
    <%# Centring and clipping live on this inner area, not the stage itself: the Media metadata panel below is a
        sibling of it, not a child, so opening the panel (a position: absolute slide) can never feed back into
        the centred image's layout (see digital_assets.css). %>
    <div class="digital-assets__media-area">
      <% if withheld? %>
        <%= render NexusCcs::AccessNoticeComponent.new(document: @document) %>
      <% end %>
      <% if gated? %>
        <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: sensitivity_state) %>
      <% end %>
      <% if main %>
        <figure class="digital-assets__main">
          <%= image_tag main.first, alt: alt(1), class: "digital-assets__image", data: { media_viewer_target: "image" } %>
        </figure>
      <% end %>

      <% media.each do |item| %>
        <figure class="digital-assets__media">
          <% case item[:kind] %>
          <% when "video" %>
            <video controls <%= "controlsList=nodownload" unless downloadable? %> preload="metadata" class="digital-assets__video" aria-label="<%= media_title(item) %>">
              <source src="<%= item[:url] %>" type="<%= item[:type] %>">
              <% if downloadable? %><a href="<%= item[:url] %>">Download <%= media_title(item) %></a><% end %>
            </video>
          <% when "audio" %>
            <audio controls <%= "controlsList=nodownload" unless downloadable? %> preload="metadata" class="digital-assets__audio" aria-label="<%= media_title(item) %>">
              <source src="<%= item[:url] %>" type="<%= item[:type] %>">
              <% if downloadable? %><a href="<%= item[:url] %>">Download <%= media_title(item) %></a><% end %>
            </audio>
          <% else %>
            <%= link_to "Open #{media_title(item)} (PDF, opens in a new tab)", item[:url], target: "_blank", rel: "noopener", class: "digital-assets__pdf" %>
          <% end %>
          <figcaption><%= media_title(item) %></figcaption>
        </figure>
      <% end %>
    </div>

    <% if sensitivity_state == :viewing %>
      <%= render NexusCcs::SensitivityGateComponent.new(document: @document, state: :viewing) %>
    <% end %>

    <% if tier == :view_only %>
      <%= render NexusCcs::AccessNoticeComponent.new(document: @document) %>
    <% end %>

    <% if metadata? %>
      <aside id="media-metadata" class="digital-assets__panel" aria-labelledby="media-metadata-heading" aria-hidden="true" data-media-viewer-target="panel">
        <div class="digital-assets__panel-head">
          <h3 id="media-metadata-heading" class="digital-assets__panel-title">Media metadata</h3>
          <button type="button" class="digital-assets__button" data-action="media-viewer#closePanel" aria-label="Close media metadata">
            <svg width="1em" height="1em" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.67" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M4.5 4.5l11 11M15.5 4.5l-11 11" /></svg>
          </button>
        </div>
        <dl class="digital-assets__list">
          <% metadata.each do |label, text| %>
            <div class="digital-assets__item">
              <dt><%= label %></dt>
              <dd><%= text %></dd>
            </div>
          <% end %>
        </dl>
      </aside>
    <% end %>
  </div>

  <% if others.any? %>
    <ul class="digital-assets__others">
      <% others.each_with_index do |(large, thumbnail), index| %>
        <li>
          <% if downloadable? %>
            <%= link_to large, class: "digital-assets__other", target: "_blank", rel: "noopener",
                  data: { action: "media-viewer#show", media_viewer_large: large, media_viewer_alt: alt(index + 2) } do %>
              <%= image_tag thumbnail, alt: "#{alt(index + 2)} (opens full size in a new tab)", loading: "lazy" %>
            <% end %>
          <% else %>
            <%# No link to the file: the thumbnail only changes the image on show %>
            <button type="button" class="digital-assets__other" data-action="media-viewer#show" data-media-viewer-large="<%= large %>" data-media-viewer-alt="<%= alt(index + 2) %>">
              <%= image_tag thumbnail, alt: alt(index + 2), loading: "lazy" %>
            </button>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="digital-assets__toolbar">
    <div class="digital-assets__toolbar-inner">
      <% if licence %>
        <p class="digital-assets__licence"><%= icon("media-copyright") %><span><span class="visually-hidden">Licence: </span><%= licence %></span></p>
      <% else %>
        <span></span>
      <% end %>
      <div class="digital-assets__controls">
        <% if metadata? %>
          <button type="button" class="digital-assets__button" aria-controls="media-metadata" aria-expanded="false" aria-label="Media metadata" title="Media metadata"
                  data-media-viewer-target="infoButton" data-action="media-viewer#togglePanel"><%= icon("media-info") %></button>
        <% end %>
        <% if assets_shown? %>
        <button type="button" class="digital-assets__button" aria-label="Full screen" title="Full screen" hidden
                data-media-viewer-target="fullscreenButton" data-action="media-viewer#toggleFullscreen"><%= icon("media-fullscreen") %></button>
        <% end %>
      </div>
    </div>
  </div>
</section>
