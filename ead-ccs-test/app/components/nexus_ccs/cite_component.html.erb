<div class="cite" data-controller="dialog">
  <button type="button" class="cite__button" aria-haspopup="dialog" data-action="dialog#open">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 11H6a1 1 0 0 1-1-1V7a2 2 0 0 1 2-2h2v4a4 4 0 0 1-4 4" /><path d="M20 11h-4a1 1 0 0 1-1-1V7a2 2 0 0 1 2-2h2v4a4 4 0 0 1-4 4" /></svg>
    <span><%= t("nexus_ccs.cite.button") %></span>
  </button>

  <dialog class="modal uom-dialog uom-modal cite__dialog" id="<%= dialog_id %>" data-dialog-target="dialog"
          data-action="click->dialog#closeOnBackdrop" aria-labelledby="<%= dialog_id %>-title">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <button type="button" class="modal-close" data-action="dialog#close"><%= t("nexus_ccs.cite.close") %></button>
        <div class="modal-header">
          <h2 class="modal-title h5" id="<%= dialog_id %>-title"><%= t("nexus_ccs.cite.title") %></h2>
        </div>
        <div class="modal-body">
          <p class="cite__intro"><%= t("nexus_ccs.cite.intro", title: title, date: accessed_text) %></p>
          <ul class="cite__list">
            <% citations.each do |style, label, text| %>
              <li class="cite__item" data-controller="clipboard">
                <h3 class="cite__style" id="<%= dialog_id %>-<%= style %>"><%= label %></h3>
                <p class="cite__text" data-clipboard-target="source" data-copy="<%= text %>"><%= text %></p>
                <button type="button" class="cite__copy" data-action="clipboard#copy" data-clipboard-target="button"
                        aria-label="<%= t('nexus_ccs.cite.copy_named', style: label) %>">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="1" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></svg>
                  <span data-clipboard-target="label"><%= t("nexus_ccs.cite.copy") %></span>
                </button>
                <p class="visually-hidden" role="status" data-clipboard-target="status"></p>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </dialog>
</div>
