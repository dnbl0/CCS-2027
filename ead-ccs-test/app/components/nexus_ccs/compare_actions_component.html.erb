<div class="compare-actions">
  <% if several_images? %>
    <%= link_to "Compare images", compare_path(record: id), class: "compare-actions__link", rel: "nofollow" %>
  <% end %>
  <% if in_comparison? %>
    <%= button_to compare_item_path(id), method: :delete, class: "compare-actions__button", form: { class: "compare-actions__form" },
                  params: { return_to: "record" }, aria: { label: "Remove from compare: #{title}" } do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="8" height="16" rx="1" /><rect x="13" y="4" width="8" height="16" rx="1" /></svg><span>Remove from compare</span>
    <% end %>
  <% elsif full? %>
    <p class="compare-actions__note">The comparison holds <%= CompareList::MAX %> records. Remove one to add this record.</p>
  <% else %>
    <%= button_to compare_items_path, params: { id: id }, class: "compare-actions__button", form: { class: "compare-actions__form" },
                  aria: { label: "Add to compare: #{title}" } do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="8" height="16" rx="1" /><rect x="13" y="4" width="8" height="16" rx="1" /></svg><span>Add to compare</span>
    <% end %>
  <% end %>
  <% if comparison_size.positive? %>
    <%= link_to "Open comparison (#{comparison_size})", compare_path, class: "compare-actions__link", rel: "nofollow" %>
  <% end %>
</div>
