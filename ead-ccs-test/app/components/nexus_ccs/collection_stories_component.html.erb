<%# "Stories from the collection", after the National Gallery of Art's article listings: one story is a wide row, two or more a card
    grid. In each story the headline comes first in the reading order; the picture is placed by collection_stories.css. %>
<div class="more-like-this collection-stories">
  <div class="more-like-this__inner">
    <section id="collection-stories" aria-labelledby="collection-stories-heading">
      <h2 id="collection-stories-heading" class="more-like-this__heading"><%= t("nexus_ccs.collection_stories.heading") %></h2>
      <p class="collection-stories__description"><%= t("nexus_ccs.collection_stories.description") %></p>
      <% if feature? %>
        <%= render story_component(stories.first) %>
      <% else %>
        <ul class="collection-story-grid collection-story-grid--<%= columns %>">
          <% stories.each do |story| %>
            <li class="collection-story-grid__item"><%= render story_component(story) %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</div>
