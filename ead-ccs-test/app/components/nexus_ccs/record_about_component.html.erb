<details class="record-about record-section record-accordion" data-record-sections-target="section" id="about-this-record">
  <summary><h2 id="record-about-heading" class="record-section__heading"><%= t("nexus_ccs.record_page.sections.about") %></h2></summary>
  <div class="record-section__body">
  <%= render NexusCcs::PersistentLinkComponent.new(url: url, document: document) %>
  <%= render NexusCcs::ContactCollectionComponent.new(document: document, url: url) %>
  <div class="record-about__correction">
    <p><%= t("nexus_ccs.record_page.about.correction_note") %>
      <a href="<%= correction_href %>"<% if correction_new_tab? %> target="_blank" rel="noopener"<% end %>><%= t("nexus_ccs.record_page.about.correction") %><% if correction_new_tab? %><span class="visually-hidden"> <%= t("nexus_ccs.record_page.no_image.ask_new_tab") %></span><% end %></a>
    </p>
  </div>
  </div>
</details>
