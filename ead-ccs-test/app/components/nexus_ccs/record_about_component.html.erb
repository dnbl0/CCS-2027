<%= tag.section class: "record-about", id: (heading? ? "about-this-record" : nil), aria: { labelledby: (heading? ? "record-about-heading" : nil) } do %>
  <% if heading? %><h2 class="record-showcase__section-heading" id="record-about-heading"><%= t("nexus_ccs.record_page.sections.about") %></h2><% end %>
  <div class="record-about__text">
    <p><%= t("nexus_ccs.record_page.split.about.improve.body") %></p>
    <p><%= advisory %></p>
  </div>
  <p class="record-about__action">
    <a class="record-about__button" href="<%= correction_href %>"<% if correction_new_tab? %> target="_blank" rel="noopener"<% end %>><%= t("nexus_ccs.record_page.showcase.suggest") %><% if correction_new_tab? %><span class="visually-hidden"> <%= t("nexus_ccs.record_page.no_image.ask_new_tab") %></span><% end %></a>
  </p>

  <div class="record-about__use">
    <ul class="record-about__links">
      <li><button type="button" class="record-about__print" data-controller="print" data-action="print#print">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2" /><path d="M6 14h12v7H6z" /></svg>
        <span><%= t("nexus_ccs.record_page.showcase.print") %></span></button></li>
      <% if export_path || manifest_path %>
        <li class="record-about__downloads"><span><%= t("nexus_ccs.record_page.showcase.download_as") %></span>
          <% if export_path %><a href="<%= export_path %>"><%= t("nexus_ccs.record_page.showcase.csv") %></a><% end %>
          <% if manifest_path %><a href="<%= manifest_path %>" type="application/ld+json"><%= t("nexus_ccs.record_page.showcase.iiif") %></a><% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
