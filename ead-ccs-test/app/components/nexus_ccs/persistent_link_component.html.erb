<div class="persistent-link" role="group" aria-labelledby="persistent-link-heading" data-controller="clipboard">
  <div class="persistent-link__row">
    <div class="persistent-link__text">
      <div class="persistent-link__title">
        <h3 id="persistent-link-heading" class="persistent-link__heading"><%= t("nexus_ccs.record_page.about.persistent_link") %></h3>
        <%= render NexusCcs::HelpTipComponent.new(topic: :persistent_link) %>
      </div>
      <input type="text" class="persistent-link__url" value="<%= url %>" readonly autocomplete="off" aria-label="Persistent link" data-clipboard-target="source">
    </div>
    <button type="button" class="persistent-link__copy" data-action="clipboard#copy" data-clipboard-target="button">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></svg>
      <span data-clipboard-target="label">Copy link</span>
    </button>
  </div>
  <div class="persistent-link__footer">
    <p class="persistent-link__note"><%= note %></p>
    <% if document %><div class="persistent-link__browser"><%= render NexusCcs::ViewFullRecordComponent.new(document: document, action: nil) %></div><% end %>
  </div>
  <p class="visually-hidden" role="status" data-clipboard-target="status"></p>
</div>
