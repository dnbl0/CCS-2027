<div class="deep-zoom" data-controller="deep-zoom" data-deep-zoom-sources-value="<%= sources.to_json %>" data-deep-zoom-label-value="<%= label %>"
     data-action="media-viewer:shown@window->deep-zoom#imageChanged">
  <%# Hidden until the script has loaded: without JavaScript the toggle would do nothing %>
  <button type="button" class="deep-zoom__button deep-zoom__toggle" hidden aria-pressed="false" data-deep-zoom-target="toggle" data-action="deep-zoom#toggle"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4M11 8v6M8 11h6" /></svg><span>Zoom and pan</span></button>
  <div class="deep-zoom__controls" role="group" aria-label="Zoom controls" hidden data-deep-zoom-target="controls">
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#zoomIn">Zoom in</button>
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#zoomOut">Zoom out</button>
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#reset">Reset view</button>
  </div>
  <div class="deep-zoom__stage" hidden data-deep-zoom-target="stage"></div>
</div>
