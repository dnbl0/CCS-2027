<div class="deep-zoom" data-controller="deep-zoom" data-deep-zoom-sources-value="<%= sources.to_json %>" data-deep-zoom-label-value="<%= label %>"
     data-action="media-viewer:shown@window->deep-zoom#imageChanged">
  <%# Hidden until the script has loaded: without JavaScript the toggle would do nothing %>
  <button type="button" class="deep-zoom__button deep-zoom__toggle" hidden aria-pressed="false" data-deep-zoom-target="toggle" data-action="deep-zoom#toggle"><%= t("nexus_ccs.zoom.toggle") %></button>
  <div class="deep-zoom__controls" role="group" aria-label="<%= t("nexus_ccs.zoom.controls") %>" hidden data-deep-zoom-target="controls">
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#zoomIn"><%= t("nexus_ccs.zoom.zoom_in") %></button>
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#zoomOut"><%= t("nexus_ccs.zoom.zoom_out") %></button>
    <button type="button" class="deep-zoom__button" data-action="deep-zoom#reset"><%= t("nexus_ccs.zoom.reset") %></button>
  </div>
  <div class="deep-zoom__stage" hidden data-deep-zoom-target="stage"></div>
</div>
