<%# About the language in our records: what the de-bias notice on a record page is. PLACEHOLDER WORDING until the collections team and the University's Indigenous advisers approve it: the marked notice stays on the page until then. %>
<% content_for :body_class, "page-help" %>
<% content_for :title, "#{t('nexus_ccs.debias.page.title')} — Collections Navigator — University of Melbourne" %>
<%= render NexusCcs::PageBreadcrumbsComponent.new(trail: [ [ t("nexus_ccs.debias.page.crumb"), nil ] ]) %>
<%= render NexusCcs::PageBannerComponent.new(title: t("nexus_ccs.debias.page.title"), description: t("nexus_ccs.debias.page.description")) %>
<main class="help-main-content help-main-content--topic" id="main-content">
<div class="help-layout">
<nav class="jump-nav" aria-labelledby="jump-nav-title" data-controller="jump-nav">
  <div class="jump-nav__container">
    <p class="jump-nav__title" id="jump-nav-title">On this page</p>
    <ul class="jump-nav__list">
      <li class="jump-nav__item"><a class="jump-nav__link" data-jump-nav-target="link" href="#our-approach">Our approach</a></li>
