<%# On this day (OnThisDay): records made on today's day and month, or from this year some years ago; pictures only. Left out when none. %>
<% found = OnThisDay.for %>
<% if found.any? %>
  <section class="ccs-section home-more" aria-labelledby="home-on-this-day">
    <div class="ccs-section__inner explore__inner">
      <h2 id="home-on-this-day" class="ccs-section__heading"><%= t("nexus_ccs.home_more.on_this_day") %></h2>
      <p class="explore__intro"><%= found.kind == :day ? t("nexus_ccs.home_more.on_this_day_day", date: l(found.date, format: "%-d %B")) : t("nexus_ccs.home_more.on_this_day_years", year: found.date.year - found.years_ago, count: found.years_ago) %></p>
      <ul class="object-cards__list">
        <% found.documents.each do |document| %><li class="object-cards__item"><%= render NexusCcs::RecordCardComponent.new(document: document) %></li><% end %>
      </ul>
    </div>
  </section>
<% end %>
