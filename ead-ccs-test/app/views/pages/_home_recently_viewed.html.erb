<%# The records this visitor opened last (RecentlyViewed, kept in their own session cookie). Left out for a first visit. %>
<% recent = RecentlyViewed.new(session).ids.any? ? RecentlyViewed.new(session).documents(except: nil) : [] %>
<% if recent.any? %>
  <section class="ccs-section home-more" aria-labelledby="home-recently-viewed">
    <div class="ccs-section__inner explore__inner">
      <h2 id="home-recently-viewed" class="ccs-section__heading"><%= t("nexus_ccs.recently_viewed.heading") %></h2>
      <ul class="object-cards__list">
        <% recent.each do |document| %><li class="object-cards__item"><%= render NexusCcs::RecordCardComponent.new(document: document, compact: true) %></li><% end %>
      </ul>
    </div>
  </section>
<% end %>
