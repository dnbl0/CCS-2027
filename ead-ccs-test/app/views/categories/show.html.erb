<%# One way of grouping the records (Categories), on the Browse list template: the centred head, the sort as tabs; on the first page by most
    records, the four with the most records lead as the home page's cluster (Google Arts & Culture's "Clusters"); then every other value as
    the fluid mosaic (a collection or named collection opens its own page), 48 a page %>
<% content_for :title, "#{@dimension.title} — #{t('nexus_ccs.categories.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-places page-categories" %>
<main class="places-page" id="main-content">
  <div class="places-page__inner">
    <%= render "browse/page_head", title: @dimension.title, intro: @dimension.intro %>
    <div class="places-nav">
      <nav class="places-views" aria-label="<%= t("nexus_ccs.categories.sort_label") %>">
        <% Categories::SORTS.each do |sort| %>
          <%= link_to t("nexus_ccs.categories.sort.#{sort}"), category_path(@dimension.slug, sort: (sort == "count" ? nil : sort)),
                      class: "places-views__link", "aria-current": (@page.sort == sort ? "page" : nil) %>
        <% end %>
      </nav>
      <p class="places-list__summary"><%= t("nexus_ccs.categories.showing", count: number_with_delimiter(@page.total)) %></p>
    </div>
    <% lead = @page.page == 1 && @page.sort == "count" ? category_section_tiles(@dimension, @page.tiles.first(12), NexusCcs::ClusterComponent::COUNTS.max) : [] %>
    <% lead = [] if lead.size < NexusCcs::ClusterComponent::COUNTS.min %>
    <% if lead.any? %>
      <section class="categories-lead" aria-labelledby="categories-lead-heading">
        <h2 class="place-section__heading categories-lead__heading" id="categories-lead-heading"><%= t("nexus_ccs.categories.leading") %></h2>
        <%= render NexusCcs::ClusterComponent.new(tiles: lead, label: t("nexus_ccs.categories.leading")) %>
      </section>
    <% end %>
    <% rest = @page.tiles.map { |tile| category_tile(tile, @dimension) }.reject { |tile| lead.any? { |shown| shown.path == tile.path } } %>
    <% if rest.any? %>
      <h2 class="<%= lead.any? ? "place-section__heading categories-lead__heading" : "visually-hidden" %>"><%= t("nexus_ccs.categories.showing", count: number_with_delimiter(@page.total)) %></h2>
      <%# a collection or named collection opens its own page; any other value, its records in the search %>
      <%= render NexusCcs::MosaicComponent.new(tiles: rest, label: @dimension.title, lanes: 6) %>
    <% end %>
    <%= render "browse_entities/pager", page: @page.page, pages: @page.pages, label: t("nexus_ccs.categories.pagination", kind: @dimension.title.downcase) %>
    <p class="places-page__more"><%= link_to t("browse.footer_link"), browse_path, class: "arrow-link arrow-link--icon" %></p>
  </div>
</main>
