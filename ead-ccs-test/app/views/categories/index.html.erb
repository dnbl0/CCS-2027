<%# Every way of grouping the records (Categories) on the home page's layouts: the Browse pages' centred head, then a full-width section
    for each, its heading and "See all" on the left and right as the home page's, its cards in one of the home page's layouts
    (CategoriesHelper::CATEGORY_LAYOUTS: Google Arts & Culture's stacks, clusters and story carousel), the sections' backgrounds taking turns
    and two on bands of colour. No picture twice. %>
<% content_for :title, "#{t('nexus_ccs.categories.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-places page-categories" %>
<main class="categories-page" id="main-content">
  <div class="places-page places-page--head"><div class="places-page__inner">
    <%= render "browse/page_head", title: t("nexus_ccs.categories.title"), intro: t("nexus_ccs.categories.description") %>
  </div></div>
  <% Categories.all.each do |dimension| %>
    <% page = Categories.page(dimension) %>
    <% next unless page&.tiles&.any? %>
    <% layout, count, tint = category_layout(dimension) %>
    <%= render NexusCcs::HomeSectionComponent.new(id: "categories-#{dimension.slug}", heading: dimension.title, intro: dimension.intro, tint: tint,
                                                  link: t("browse.cards.see_all", kind: dimension.title.downcase), link_path: dimension.path,
                                                  extra_class: "browse-section categories-#{dimension.slug}") do %>
      <%= render "categories/section_cards", dimension: dimension, layout: layout, tiles: category_section_tiles(dimension, page.tiles, count), all: page.tiles %>
    <% end %>
  <% end %>
</main>
