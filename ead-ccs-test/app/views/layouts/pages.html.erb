<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= render "layouts/light_theme" %>
    <%= render "layouts/seo_head" %>
    <title><%= content_for(:title) || "Collections Navigator - University of Melbourne" %></title>
    <script nonce="<%= content_security_policy_nonce %>">document.documentElement.classList.remove("no-js");</script>
    <%= favicon_link_tag %>
    <%= csrf_meta_tags %>
    <%= render "layouts/font_preload" %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= content_for(:head) %>
  </head>
  <body class="<%= content_for(:body_class) %>">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%= render "layouts/cookie_notice" %>
    <%= render "layouts/noscript_notice" %>
    <%= render blacklight_config.header_component.new(blacklight_config: blacklight_config) %>
    <%= render "shared/flash_msg", layout: "shared/flash_messages" if flash.any? %>
    <%= yield %>
    <%= render "shared/footer" %>
  </body>
</html>
