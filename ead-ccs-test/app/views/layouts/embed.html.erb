<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="<%= RobotsPolicy.directive(request.path) %>">
    <title><%= yield(:title).presence || "Collections Navigator - University of Melbourne" %></title>
    <%= favicon_link_tag %>
    <%# One stylesheet and no script: a frame on another site loads little and runs nothing of ours %>
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>
  <body class="embed">
    <%= yield %>
    <footer class="embed-attribution">
      <p><%= t("nexus_ccs.embed.attribution_html", site: link_to(t("nexus_ccs.embed.site_name"), site_url("/"), target: "_blank", rel: "noopener")) %></p>
    </footer>
  </body>
</html>
