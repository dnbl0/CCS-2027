<%# Time's third view, the timeline (Explore::Timeline; ?view=timeline or ?century=), inside the one Browse template (browse/_template),
    after Google Arts & Culture's Color Explorer as colours' spectrum is: a strip of the centuries, earliest first, each the same width with a bar for its number of records (the square root of its share of the
    busiest, so the small centuries stay visible; the note says so), the chosen one marked by a notch and kept in view
    (explore_strip_controller.js). Before a century is chosen, the centuries as picture tiles, each opening its own page where it has one
    (Browse::Periods, from 1000), and the eras folded after; with ?century=, its records as a wall of square pictures (explore/_picture_wall)
    and its decades as tiles. The strip and what is under it are one Turbo frame, so choosing a century swaps them in place and the address
    follows; the breadcrumb and the heading, outside the frame, are the same for every century. Without JavaScript the strip's items are
    plain links. The earliest period ("Earlier", before 3000 BCE) is not a century: it opens its records. %>
<% periods = @centuries&.periods || [] %>
<% chosen = periods.find { |period| period.first == @century } if @century %>
<% hub = BrowseHubs.find("periods") %>
<% title = [ chosen&.label, t("browse.hub.explorers.timeline"), hub.title ].compact.join(" — ") %>
<%= render layout: "browse/template", locals: { hub: hub, title: title } do %>
  <div class="places-nav"><%= render "browse/views", hub: hub, view: :explorer %></div>
    <div class="time-explorer">
      <% if @centuries.nil? %>
        <p class="browse__unavailable"><%= t("explore_pages.unavailable_html", link: link_to(t("explore_pages.search_all"), search_action_path(any_assets: "1", search_field: "all_fields"))) %></p>
      <% elsif periods.empty? %>
        <p><%= t("explore_pages.time.empty") %></p>
      <% else %>
        <%# The frame's links leave it (target _top: the tiles open the periods' own pages) unless they name it (the strip, All centuries) %>
        <turbo-frame id="time-explorer" target="_top" data-turbo-action="advance">
          <nav class="explore-strip explore-strip--time" aria-label="<%= t("explore_pages.time.strip_label") %>" data-controller="explore-strip" data-explore-strip-title-value="<%= "#{title} — Collections Navigator — University of Melbourne" %>">
            <ul class="explore-strip__list">
              <% periods.each do |period| %>
                <% words = t("explore_pages.time.strip_item", short: period.short_label, period: period.label) %>
                <% path = period.before? ? (timeline_period_path(period) || search_action_path(period.search_query)) : explore_time_path(century: period.first) %>
                <li class="explore-strip__item">
                  <%= link_to path, class: "explore-strip__period", title: words, aria: { label: words, current: ("page" if period == chosen) },
                                    data: { explore_strip_target: ("chosen" if period == chosen), turbo_frame: ("time-explorer" unless period.before?) } do %>
                    <span class="explore-strip__year"><%= period.short_label %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </nav>
          <p class="explore-strip__note"><%= t("explore_pages.time.strip_note") %></p>

          <% if chosen %>
            <%= render "explore/picture_wall", records: @records, heading: chosen.label,
                       unavailable: t("explore_pages.unavailable_html", link: link_to(t("explore_pages.search_all"), search_action_path(chosen.search_query))),
                       links: [ [ t("explore_pages.time.see_all"), timeline_period_path(chosen) || search_action_path(chosen.search_query) ] ] %>
            <% if @timeline&.periods.present? %>
              <section class="place-section time-explorer__periods" aria-labelledby="timeline-heading">
                <h2 class="place-section__heading" id="timeline-heading"><%= t("explore_pages.time.decades", period: chosen.label) %></h2>
                <% tiles = @timeline.periods.map { |period| facet_tile(period.label, timeline_period_path(period) || search_action_path(period.search_query), period.images.first) } %>
                <%= render "browse_entities/facet_tiles", tiles: tiles, label: t("explore_pages.time.list_label"), ordered: true %>
              </section>
            <% end %>
            <p class="time-explorer__back"><%= link_to t("explore_pages.time.all_centuries"), explore_time_path(view: "timeline"), class: "arrow-link arrow-link--icon", data: { turbo_frame: "time-explorer" } %></p>
          <% else %>
            <section class="place-section time-explorer__periods" aria-labelledby="timeline-heading">
              <h2 class="place-section__heading" id="timeline-heading"><%= t("explore_pages.time.centuries") %></h2>
              <% tiles = periods.map { |period| facet_tile(period.label, timeline_period_path(period) || search_action_path(period.search_query), period.images.first) } %>
              <%= render "browse_entities/facet_tiles", tiles: tiles, label: t("explore_pages.time.list_label"), ordered: true %>
            </section>

            <% if @centuries.eras.any? %>
              <details class="place-explorer__all time-explorer__eras">
                <summary><%= t("explore_pages.time.eras_folded") %></summary>
                <p class="time-explorer__eras-intro"><%= t("explore_pages.time.eras_intro") %></p>
                <ul class="place-chips">
                  <%# Most records first (the source data has a few impossible eras, "30th century", with one or two records: they fall to the end) %>
                  <% @centuries.eras.sort_by { |era| -era.count }.each do |era| %>
                    <li><%= link_to search_action_path(era.search_query), class: "places-chip" do %><%= era.name %><% end %></li>
                  <% end %>
                </ul>
              </details>
            <% end %>
          <% end %>
        </turbo-frame>
      <% end %>
    </div>
<% end %>
