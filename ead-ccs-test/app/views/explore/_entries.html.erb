<%# A list of filter values, each opening the search (no counts: the site shows none): entries respond to label and search_query %>
<ul class="browse__list">
  <% entries.each do |entry| %>
    <li class="browse__item">
      <%= link_to search_action_path(entry.search_query), class: "browse__link" do %>
        <span class="browse__label"><%= entry.label %></span>
      <% end %>
    </li>
  <% end %>
</ul>
