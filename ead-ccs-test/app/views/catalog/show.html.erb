<% presenter = document_presenter(@document) %>
<% @page_title = t('blacklight.search.show.title', document_title: presenter.html_title, application_name: application_name).html_safe %> <%# erblint:disable ErbSafety %>
<% content_for(:head) { render_link_rel_alternates } %>
<% content_for(:head) { oembed_link_tag(solr_document_url(@document), Array(@document["title_tsim"]).first.to_s) } %> <%# for CMS and chat tools: the embed code of this record (tier-safe) %>

<%# The page body, after the CCS UI "Record-detail"; first, where this record is in the visitor's selection (CCS-40) %>
<%= render NexusCcs::SelectionStepperComponent.new(document_id: @document.id) %>
<%= render presenter.view_config.document_component.new(id: 'document', document: presenter, component: :div, show: true, partials: presenter.view_config.partials) do |component| %>
  <% component.with_footer do %>
    <% if @document.respond_to?(:export_as_openurl_ctx_kev) %>
      <!-- COinS, for Zotero among others. -->
      <span class="Z3988" title="<%= @document.export_as_openurl_ctx_kev(presenter.display_type) %>"></span>
    <% end %>
  <% end %>
<% end %>

<%= render NexusCcs::RecordTilesComponent.new(id: "related-objects", heading: "Related objects", documents: RelatedObjects.for(@document)) %>
<%= render NexusCcs::RecordTilesComponent.new(id: "recently-viewed", heading: "Recently viewed", documents: RecentlyViewed.new(session).documents(except: @document.id)) %>
