<%# Explore by colour (ColoursController), after Google Arts & Culture's Color Explorer: the Explore template's head, then a strip of the
    colours, each swatch the same width, in the palette's order (a spectrum), the chosen one marked by a notch and kept in view
    (explore_strip_controller.js). Under it the chosen colour's records as a wall of square pictures (explore/_picture_wall), or, before a
    colour is chosen, each colour as a picture tile. The strip and what is under it are one Turbo frame, so choosing a colour swaps the wall
    in place and the address follows (?colour=); the breadcrumb, outside the frame, is the same for every colour. Without JavaScript the
    swatches are plain links. A swatch's name is its link's name and its tooltip: the colour is never the only cue. %>
<% title = "#{[ (colour_facet_label(@colour.name) if @colour), t('colours.title') ].compact.join(' — ')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-explore page-explore-colours" %>
<% content_for :title, title %>
<%= render NexusCcs::PageBreadcrumbsComponent.new(trail: [ [ "Browse", browse_path ], [ t("colours.title"), nil ] ]) %>
<main class="browse explore" id="main-content">
  <div class="place-explorer-wrap">
    <div class="time-explorer colour-explorer">
      <div class="place-explorer__head">
        <div class="place-explorer__title">
          <h1 class="place-explorer__heading"><%= t("colours.title") %></h1>
          <p class="place-explorer__intro"><%= t("colours.intro") %></p>
        </div>
      </div>

      <% if @colours.blank? %>
        <p class="colours__empty"><%= @colours.nil? ? t("colours.unavailable") : t("colours.empty") %></p>
      <% else %>
        <% field = CatalogConfig::Facets::COLOUR_FIELD %>
        <turbo-frame id="colour-explorer" data-turbo-action="advance">
          <nav class="explore-strip" aria-label="<%= t("colours.strip_label") %>" data-controller="explore-strip" data-explore-strip-title-value="<%= title %>">
            <ul class="explore-strip__list">
              <% @colours.each do |colour| %>
                <% name = colour_facet_label(colour.name) %>
                <% words = t("colours.swatch", name: name, count: colour.count, formatted: number_with_delimiter(colour.count)) %>
                <li class="explore-strip__item">
                  <%= link_to explore_colours_path(colour: colour.name), class: "explore-strip__swatch colours__swatch--#{colour.name}", title: words,
                              aria: { label: words, current: ("page" if colour == @colour) }, data: { explore_strip_target: ("chosen" if colour == @colour) } do %><% end %>
                </li>
              <% end %>
            </ul>
          </nav>
          <p class="explore-strip__note"><%= t("colours.description") %></p>

          <% if @colour %>
            <% name = colour_facet_label(@colour.name) %>
            <% numbers = { count: @colour.count, formatted: number_with_delimiter(@colour.count) } %>
            <%= render "explore/picture_wall", records: @records, unavailable: t("colours.unavailable"), count: t("colours.count", **numbers),
                       heading: safe_join([ tag.span(class: "picture-wall__dot colours__swatch--#{@colour.name}", aria: { hidden: true }), name ]),
                       links: [ [ t("colours.see_all", **numbers), search_catalog_path(f: { field => [ @colour.name ] }) ] ] %>
          <% else %>
            <section class="place-section time-explorer__periods" aria-labelledby="colours-heading">
              <h2 class="place-section__heading" id="colours-heading"><%= t("colours.heading") %></h2>
              <% tiles = @colours.map { |colour| facet_tile(colour_facet_label(colour.name), colour.count, explore_colours_path(colour: colour.name), @pictures.value(field, colour.name)) } %>
              <%= render "browse_entities/facet_tiles", tiles: tiles, label: t("colours.list_label"), ordered: true %>
            </section>
          <% end %>
        </turbo-frame>
      <% end %>
    </div>
  </div>
</main>
