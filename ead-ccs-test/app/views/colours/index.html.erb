<%# Colours' third view, the spectrum (ColoursController; ?view=spectrum or ?colour=), inside the one Browse template (browse/_template),
    after Google Arts & Culture's Color Explorer: a strip of the colours, each swatch the same width, in the palette's order (a spectrum), the chosen one marked by a notch and kept in view
    (explore_strip_controller.js). Under it the chosen colour's records as a wall of square pictures (explore/_picture_wall), or, before a
    colour is chosen, each colour as a card of four of its pictures. The strip and what is under it are one Turbo frame, so choosing a colour swaps the wall
    in place and the address follows (?colour=); the breadcrumb, outside the frame, is the same for every colour. Without JavaScript the
    swatches are plain links. A swatch's name is its link's name and its tooltip: the colour is never the only cue. %>
<% hub = BrowseHubs.find("colours") %>
<% title = [ (colour_facet_label(@colour.name) if @colour), t("browse.hub.explorers.spectrum"), hub.title ].compact.join(" — ") %>
<%= render layout: "browse/template", locals: { hub: hub, title: title } do %>
  <div class="places-nav"><%= render "browse/views", hub: hub, view: :explorer %></div>
    <div class="time-explorer colour-explorer">
      <% if @colours.blank? %>
        <p class="colours__empty"><%= @colours.nil? ? t("colours.unavailable") : t("colours.empty") %></p>
      <% else %>
        <% field = CatalogConfig::Facets::COLOUR_FIELD %>
        <turbo-frame id="colour-explorer" data-turbo-action="advance">
          <nav class="explore-strip" aria-label="<%= t("colours.strip_label") %>" data-controller="explore-strip" data-explore-strip-title-value="<%= "#{title} — Collections Navigator — University of Melbourne" %>">
            <ul class="explore-strip__list">
              <% @colours.each do |colour| %>
                <% name = colour_facet_label(colour.name) %>
                <% words = t("colours.swatch", name: name, count: colour.count, formatted: number_with_delimiter(colour.count)) %>
                <li class="explore-strip__item">
                  <%= link_to explore_colours_path(colour: colour.name), class: "explore-strip__swatch colours__swatch--#{colour.name}", title: words,
                              aria: { label: words, current: ("page" if colour == @colour) }, data: { explore_strip_target: ("chosen" if colour == @colour) } do %><% end %>
                </li>
              <% end %>
            </ul>
          </nav>
          <p class="explore-strip__note"><%= t("colours.description") %></p>

          <% if @colour %>
            <% name = colour_facet_label(@colour.name) %>
            <% numbers = { count: @colour.count, formatted: number_with_delimiter(@colour.count) } %>
            <%= render "explore/picture_wall", records: @records, unavailable: t("colours.unavailable"), count: t("colours.count", **numbers),
                       heading: safe_join([ tag.span(class: "picture-wall__dot colours__swatch--#{@colour.name}", aria: { hidden: true }), name ]),
                       links: [ [ t("colours.see_all", **numbers), search_catalog_path(f: { field => [ @colour.name ] }) ] ], band: "colours__swatch--#{@colour.name}",
                       steps: [ @previous && [ t("colours.previous", name: colour_facet_label(@previous.name)), "← #{colour_facet_label(@previous.name)}", explore_colours_path(colour: @previous.name) ],
                                @next && [ t("colours.next", name: colour_facet_label(@next.name)), "#{colour_facet_label(@next.name)} →", explore_colours_path(colour: @next.name) ] ].compact %>
          <% else %>
            <%# Before a colour is chosen: a card for each, in the spectrum's order: four of its pictures (those mostly that colour first) in a
                square, a bar of the colour, its name and number of records; the card opens its wall here %>
            <section class="colour-cards-section" aria-labelledby="colours-heading">
              <h2 class="place-section__heading" id="colours-heading"><%= t("colours.heading") %></h2>
              <ul class="colour-cards" aria-label="<%= t("colours.list_label") %>">
                <% @cards.each do |colour, pictures| %>
                  <li class="colour-card">
                    <div class="colour-card__pictures colours__swatch--<%= colour.name %>" aria-hidden="true">
                      <% pictures.each do |record| %>
                        <span class="colour-card__picture" <%= tag.attributes(style: ("--tint: #{record.tint}" if record.tint)) %>><img src="<%= DamImage.sized(AssetVersion.url(record.src), 300) %>" alt="" loading="lazy" decoding="async"></span>
                      <% end %>
                    </div>
                    <span class="colour-card__band colours__swatch--<%= colour.name %>" aria-hidden="true"></span>
                    <h3 class="colour-card__name"><%= link_to colour_facet_label(colour.name), explore_colours_path(colour: colour.name), class: "colour-card__link" %></h3>
                    <p class="colour-card__count"><%= t("colours.count", count: colour.count, formatted: number_with_delimiter(colour.count)) %></p>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        </turbo-frame>
      <% end %>
    </div>
<% end %>
