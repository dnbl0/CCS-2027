<% content_for :title, "#{t('nexus_ccs.themes.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-places page-themes" %>
<main class="places-page" id="main-content">
  <div class="places-page__inner">
    <%= render "browse/page_head", title: t("nexus_ccs.themes.title"), intro: t("nexus_ccs.themes.description") %>
    <% if @themes.empty? %>
      <p class="browse-empty"><%= t("nexus_ccs.themes.empty") %></p>
    <% else %>
      <h2 class="visually-hidden"><%= t("nexus_ccs.themes.title") %></h2>
      <%= render NexusCcs::MosaicComponent.new(tiles: discovery_tiles(@themes, text: ->(theme) { theme.intro }, fallback: ->(theme) { theme_picture(theme) }), label: t("nexus_ccs.themes.title"), lanes: 3) %>
    <% end %>
  </div>
</main>
