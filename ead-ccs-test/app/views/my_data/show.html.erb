<%# The confirmation page for Delete my data (CCS-148): says what is held and what is not removed, then one button. %>
<% content_for :title, "#{t('nexus_ccs.my_data.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-help" %>
<%= render NexusCcs::PageBannerComponent.new(title: t("nexus_ccs.my_data.title"), description: t("nexus_ccs.my_data.description")) %>

<main class="help-main-content help-main-content--topic" id="main-content">
  <div class="help-layout">
    <div class="help-layout__content">
      <div class="notice notice--warning" role="note"><p><strong>Placeholder wording, not yet approved.</strong> The University's privacy office must approve this page.</p></div>

      <section class="help-section" aria-labelledby="h-held">
        <header class="help-section__header">
          <h2 class="help-section__heading" id="h-held"><%= t("nexus_ccs.my_data.held_heading") %></h2>
          <p class="help-section__description"><%= t("nexus_ccs.my_data.held_intro") %></p>
        </header>
        <ul class="help-section__items">
          <% @held.each do |key, count| %>
            <li class="help-section__item"><p class="help-section__text"><%= t("nexus_ccs.my_data.held.#{key}", count: count) %></p></li>
          <% end %>
        </ul>
      </section>

      <section class="help-section" aria-labelledby="h-kept">
        <header class="help-section__header">
          <h2 class="help-section__heading" id="h-kept"><%= t("nexus_ccs.my_data.kept_heading") %></h2>
        </header>
        <ul class="help-section__items">
          <li class="help-section__item"><p class="help-section__text"><%= t("nexus_ccs.my_data.kept_requests_html", contact: help_path(anchor: "contact-us")) %></p></li>
        </ul>
      </section>

      <section class="help-section" aria-labelledby="h-delete">
        <header class="help-section__header">
          <h2 class="help-section__heading" id="h-delete"><%= t("nexus_ccs.my_data.delete_heading") %></h2>
          <p class="help-section__description"><%= t("nexus_ccs.my_data.delete_warning") %></p>
        </header>
        <%= button_to t("nexus_ccs.my_data.button"), my_data_path, method: :delete, class: "btn btn-danger",
                      form: { class: "my-data-delete" }, disabled: !@held.values.any?(&:positive?) %>
        <% unless @held.values.any?(&:positive?) %>
          <p class="help-section__text mt-3"><%= t("nexus_ccs.my_data.nothing") %></p>
        <% end %>
        <p class="help-section__text mt-3"><%= link_to t("nexus_ccs.my_data.privacy_link"), privacy_path %></p>
      </section>
    </div>
  </div>
</main>
