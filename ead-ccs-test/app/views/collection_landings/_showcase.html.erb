<%# The body of a collection, named collection or theme page (Showcase), on the detail-page template (browse_entities/showcase; after
    Google Arts & Culture's place pages): a strip of its own pictures (each whole), its name, its records and its introduction (placeholder
    wording) with the way to all its records; its object types, eras and named collections as chips (a named collection opens its own page);
    and "Discover", its highlights as the fluid mosaic. locals: showcase, search_query, intro, name, kind_label, back ([label, path]),
    named (a collection: its named collections open their own pages) %>
<% documents = showcase.documents %>
<% pictured = documents.select { |document| document["thumbnail_path_ssi"].present? }.last(5) %>
<main class="place-page" id="main-content">
  <% if pictured.size >= 3 %>
    <ul class="justified place-page__strip" data-controller="justified" aria-hidden="true">
      <% pictured.each do |document| %>
        <li class="justified__item"><%= image_tag AssetVersion.url(document["thumbnail_path_ssi"]), alt: "", class: "place-page__strip-image", decoding: "async" %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="place-page__inner">
    <header class="place-page__head">
      <p class="place-page__kind"><%= kind_label %></p>
      <h1 class="place-page__title"><%= name %></h1>
      <p class="place-page__summary"><%= showcase.total.positive? ? t("browse.place.records", count: showcase.total, number: number_with_delimiter(showcase.total)) : t("nexus_ccs.showcase.no_records") %></p>
      <p class="place-page__intro" data-placeholder-wording><%= intro %> <span class="showcase__placeholder">[<%= t("nexus_ccs.placeholder") %>]</span></p>
      <div class="place-page__actions">
        <% if showcase.total.positive? %><%= link_to t("nexus_ccs.showcase.see_all", count: number_with_delimiter(showcase.total)), search_catalog_path(search_query), class: "btn btn-primary" %><% end %>
        <%= link_to back.first, back.last, class: "arrow-link arrow-link--icon" %>
      </div>
    </header>

    <% groups = { "object_type_ssim" => :object_types, "date_era_ssim" => :eras, "named_collection_ssim" => :named_collections }.filter_map do |field, label|
         pairs = showcase.facets[field].to_a.reject { |value, _| Array(search_query.dig(:f, field)).include?(value) }
         [ field, label, pairs ] if pairs.any?
       end %>
    <% if groups.any? %>
      <section class="place-section place-section--facets" aria-label="<%= t("browse.place.ways_in") %>">
        <% groups.each do |field, label, pairs| %>
          <div class="place-facets">
            <h2 class="place-section__heading place-section__heading--small"><%= t("nexus_ccs.showcase.#{label}") %></h2>
            <ul class="place-chips">
              <% pairs.each do |value, count| %>
                <% own = named && field == "named_collection_ssim" ? landing_path_for("named-collections", value) : nil %>
                <li><%= link_to (own || search_catalog_path(search_query.deep_merge(f: { field => Array(search_query.dig(:f, field)) + [ value ] }))), class: "places-chip" do %><%= value.to_s.upcase_first %> <span class="places-chip__count"><%= number_with_delimiter(count) %></span><% end %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="place-section" aria-labelledby="showcase-highlights">
      <h2 id="showcase-highlights" class="place-section__heading"><%= t("nexus_ccs.showcase.highlights") %></h2>
      <% if documents.any? %>
        <%= render NexusCcs::CardLayoutComponent.new(cards: documents, layout: :mosaic, lanes: 4, label: t("nexus_ccs.showcase.highlights"),
                                                     renderer: ->(document) { NexusCcs::RecordCardComponent.new(document: document) }) %>
        <% if showcase.total > documents.size %><p class="places-page__more"><%= link_to t("nexus_ccs.showcase.see_all", count: number_with_delimiter(showcase.total)), search_catalog_path(search_query), class: "arrow-link arrow-link--icon" %></p><% end %>
      <% elsif showcase.total.positive? %>
        <p class="browse-empty"><%= t("nexus_ccs.showcase.none") %></p>
      <% end %>
    </section>
  </div>
</main>
