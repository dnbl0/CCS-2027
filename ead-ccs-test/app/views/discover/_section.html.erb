<%# One section of Featured and trending. heading_tag is h2 on /discover and h3 on the home page, under its own h2. %>
<% heading_id = "discover-#{section.key}-heading" %>
<section class="discover-section discover-section--<%= section.key %>" aria-labelledby="<%= heading_id %>">
  <%= content_tag heading_tag, t("nexus_ccs.discover.sections.#{section.key}.heading"), id: heading_id, class: "discover-section__heading" %>
  <p class="discover-section__description"><%= t("nexus_ccs.discover.sections.#{section.key}.description", days: RecordView.window_days) %></p>
  <% if I18n.exists?("nexus_ccs.discover.sections.#{section.key}.placeholder") %><p class="discover-section__note" data-placeholder><%= t("nexus_ccs.discover.sections.#{section.key}.placeholder") %></p><% end %>
  <%= render "discover/cards", entries: section.entries, title_tag: heading_tag == :h2 ? :h3 : :h4 %>
</section>
