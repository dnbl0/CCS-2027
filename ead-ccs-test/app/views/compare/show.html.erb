<%# Compare images side by side (CCS-58, CompareController; components/compare.css). One record's images (?record=): the record named once
    in the heading with the way back to it and its details, each pane headed by the image it shows ("Image 2 of 4") with the picker at
    its top; or the records the visitor added: each pane headed by its record, with its details and Remove. Every pane has a toolbar of
    the Gen 3 text buttons joined to its image (Zoom in, Zoom out, Reset); above the panes, Move images together, adding or removing an
    image, and one Full screen for the whole comparison. Without JavaScript each pane is the plain image and the script-only
    controls are hidden. Panes stack on a narrow screen. %>
<% heading = @record_mode ? t("nexus_ccs.compare.record_title", title: @record_title) : t("nexus_ccs.compare.list_title") %>
<% content_for :title, "#{heading} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-saved page-compare" %>
<%= render NexusCcs::PageBannerComponent.new(title: heading, description: t(@record_mode ? "nexus_ccs.compare.record_description" : "nexus_ccs.compare.description")) %>

<main class="saved-main" id="main-content">
  <div class="saved-main__inner compare" data-controller="compare"
       data-enter-label="<%= t("nexus_ccs.compare.fullscreen") %>" data-exit-label="<%= t("nexus_ccs.compare.exit_fullscreen") %>">
    <% if @record_mode %>
      <%# the way back to the record, and its details once (every pane shows one of its images) %>
      <div class="compare__record">
        <%= link_to t("nexus_ccs.compare.back", title: @record_title), solr_document_path(params[:record]), class: "arrow-link arrow-link--icon compare__back" %>
        <% first = @panes.first %>
        <% if first %>
          <dl class="compare__details">
            <% if first.accession_number %><div><dt><%= t("nexus_ccs.compare.accession_number") %></dt><dd><%= first.accession_number %></dd></div><% end %>
            <div><dt><%= t("nexus_ccs.compare.licence") %></dt><dd><%= first.licence || t("nexus_ccs.compare.not_stated") %></dd></div>
          </dl>
        <% end %>
      </div>
    <% end %>

    <% if @unavailable.to_i.positive? %>
      <p class="compare__note" role="status"><%= t("nexus_ccs.compare.unavailable", count: @unavailable) %></p>
    <% end %>

    <% with_images = search_action_path(f: { has_digital_asset: [ "with" ] }, search_field: "all_fields", view: "masonry") %>
    <% if @panes.empty? %>
      <%# Nothing yet: how to compare, in three steps, and the way to records with images %>
      <div class="compare__empty">
        <h2 class="compare__empty-heading"><%= t("nexus_ccs.compare.empty_heading") %></h2>
        <ol class="compare__steps">
          <% t("nexus_ccs.compare.steps").each do |step| %><li><%= step %></li><% end %>
        </ol>
        <%= link_to t("nexus_ccs.compare.find_records"), with_images, class: "btn btn-primary" %>
      </div>
    <% else %>

      <div class="compare__toolbar" role="group" aria-label="<%= t("nexus_ccs.compare.tools") %>">
        <% if @panes.size > 1 %>
        <div class="compare__link form-check" data-js-only>
          <input type="checkbox" id="compare-link" class="form-check-input" checked aria-describedby="compare-link-hint" data-compare-target="link">
          <label for="compare-link" class="form-check-label"><%= t("nexus_ccs.compare.link") %></label>
          <p class="compare__hint" id="compare-link-hint"><%= t("nexus_ccs.compare.link_hint") %></p>
        </div>
        <% end %>
        <div class="compare__toolbar-actions">
          <% if @record_mode %>
            <% if @panes.size < [ CompareList::MAX, @panes.first.images.size ].min %>
              <%= link_to t("nexus_ccs.compare.add_image"), compare_path(record: params[:record], panes: @panes.size + 1), class: "btn btn-outline-primary" %>
            <% end %>
            <% if @panes.size > CompareController::MIN_PANES %>
              <%= link_to t("nexus_ccs.compare.remove_image"), compare_path(record: params[:record], panes: @panes.size - 1), class: "btn btn-outline-primary" %>
            <% end %>
          <% else %>
            <%= button_to t("nexus_ccs.compare.clear"), clear_compare_path, method: :delete, class: "btn btn-outline-primary", form: { class: "d-inline" } %>
          <% end %>
          <button type="button" class="text-button compare__fullscreen" data-js-only data-fullscreen data-action="compare#fullscreen"><span data-fullscreen-label><%= t("nexus_ccs.compare.fullscreen") %></span><%= NexusCcs::Glyphs.icon(:fullscreen) %></button>
        </div>
      </div>

      <% waiting = @panes.size == 1 && !@record_mode %>
      <ul class="compare__panes compare__panes--<%= waiting ? 2 : @panes.size %>">
        <% @panes.each_with_index do |pane, number| %>
          <% sources = pane.images.each_with_index.map { |image, index| { url: image.url, info: image.info_url, alt: image.alt } } %>
          <% current = pane.images[pane.index] %>
          <% position = t("nexus_ccs.compare.position", position: pane.index + 1, count: pane.images.size) %>
          <li class="compare__item"><div class="compare-pane" data-compare-target="pane" data-sources="<%= sources.to_json %>" role="group" aria-labelledby="compare-pane-<%= number %>-title">
            <header class="compare-pane__header compare-pane__header--<%= @record_mode ? "image" : "record" %>">
              <% if @record_mode %>
                <%# the pane is named by the image it shows; its picker beside the name %>
                <h2 id="compare-pane-<%= number %>-title" class="compare-pane__title" data-pane-heading><%= position %></h2>
              <% else %>
                <div class="compare-pane__record">
                  <h2 id="compare-pane-<%= number %>-title" class="compare-pane__title"><%= link_to pane.title, solr_document_path(pane.record_id), class: "ccs-text-link" %></h2>
                  <dl class="compare__details">
                    <% if pane.accession_number %><div><dt><%= t("nexus_ccs.compare.accession_number") %></dt><dd><%= pane.accession_number %></dd></div><% end %>
                    <div><dt><%= t("nexus_ccs.compare.licence") %></dt><dd><%= pane.licence || t("nexus_ccs.compare.not_stated") %></dd></div>
                  </dl>
                </div>
                <%= button_to compare_item_path(pane.record_id), method: :delete, class: "text-button compare-pane__remove",
                              form: { class: "compare-pane__remove-form" }, aria: { label: t("nexus_ccs.compare.remove_record", title: pane.title) } do %>
                  <span><%= t("nexus_ccs.compare.remove") %></span><%= NexusCcs::Glyphs.icon(:close) %>
                <% end %>
              <% end %>
              <% if pane.images.size > 1 %>
                <div class="compare-pane__choose" data-js-only>
                  <label for="compare-pane-<%= number %>-image"><%= t("nexus_ccs.compare.show") %></label>
                  <select id="compare-pane-<%= number %>-image" class="form-select" data-action="compare#choose">
                    <% pane.images.each_with_index do |image, index| %>
                      <option value="<%= index %>" <%= "selected" if index == pane.index %>><%= t("nexus_ccs.compare.position", position: index + 1, count: pane.images.size) %></option>
                    <% end %>
                  </select>
                </div>
              <% end %>
              <p class="visually-hidden">Showing <span data-pane-image-name><%= current.alt %></span></p>
            </header>
            <div class="compare-pane__stage" data-stage>
              <img src="<%= current.url %>" alt="<%= current.alt %>" class="compare-pane__image" decoding="async" <%= tag.attributes(ImageDimensions.for_path(current.url)&.then { |w, h| { width: w, height: h } } || {}) %>>
            </div>
            <div class="compare-pane__tools" data-js-only role="group" aria-label="<%= t("nexus_ccs.compare.pane_tools", name: (@record_mode ? position : pane.title)) %>">
              <button type="button" class="text-button" data-action="compare#zoomIn"><span><%= t("nexus_ccs.compare.zoom_in") %></span><%= NexusCcs::Glyphs.icon(:zoom_in) %></button>
              <button type="button" class="text-button" data-action="compare#zoomOut"><span><%= t("nexus_ccs.compare.zoom_out") %></span><%= NexusCcs::Glyphs.icon(:zoom_out) %></button>
              <button type="button" class="text-button" data-action="compare#reset"><span><%= t("nexus_ccs.compare.reset") %></span><%= NexusCcs::Glyphs.icon(:reset_zoom) %></button>
            </div>
          </div></li>
        <% end %>
        <% if waiting %>
          <%# The second place, waiting for a record: what to do, and the way to records with images %>
          <li class="compare__item compare__item--waiting">
            <div class="compare-slot">
              <h2 class="compare-slot__heading"><%= t("nexus_ccs.compare.slot_heading") %></h2>
              <p class="compare-slot__text"><%= t("nexus_ccs.compare.one_pane") %></p>
              <%= link_to t("nexus_ccs.compare.find_records"), with_images, class: "btn btn-outline-primary" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</main>
