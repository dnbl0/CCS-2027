<%# One level of the Place filter and, in a disclosure, the levels under it (NexusCcs::PlaceHierarchyFacetComponent) %>
<li>
  <div class="place-hierarchy__row"><%= component.item(node) %></div>
  <% if node.children.any? %>
    <details<%= " open" if component.open?(node) %>>
      <summary><%= t("nexus_ccs.place_hierarchy.within", place: component.label(node)) %></summary>
      <ul>
        <% component.sort(node.children).each do |child| %>
          <%= render "nexus_ccs/place_hierarchy_node", node: child, component: component %>
        <% end %>
      </ul>
    </details>
  <% end %>
</li>
