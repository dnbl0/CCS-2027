<%# Stories, after the British Museum's blog: the newest story large, then the rest as a grid of cards (StoryCardComponent) %>
<% content_for :title, "#{t('nexus_ccs.stories.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-stories" %>
<%= render NexusCcs::PageBannerComponent.new(title: t("nexus_ccs.stories.title"), description: t("nexus_ccs.stories.description")) %>
<main class="browse-main" id="main-content">
  <div class="browse-main__inner">
    <% if @stories.empty? %>
      <p class="browse-empty"><%= t("nexus_ccs.stories.empty") %></p>
    <% else %>
      <ul class="stories-index">
        <% @stories.each_with_index do |story, index| %>
          <li class="stories-index__item<%= " stories-index__item--lead" if index.zero? %>">
            <%= render NexusCcs::StoryCardComponent.new(story: story, document: @documents[story.hero || story.records.first], lead: index.zero?) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</main>
