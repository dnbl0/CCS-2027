<% content_for :title, "#{t('nexus_ccs.stories.title')} — Collections Navigator — University of Melbourne" %>
<% content_for :body_class, "page-browse page-places page-stories" %>
<main class="places-page" id="main-content">
  <div class="places-page__inner">
    <%= render "browse/page_head", title: t("nexus_ccs.stories.title"), intro: t("nexus_ccs.stories.description") %>
    <% if @stories.empty? %>
      <p class="browse-empty"><%= t("nexus_ccs.stories.empty") %></p>
    <% else %>
      <h2 class="visually-hidden"><%= t("nexus_ccs.stories.title") %></h2>
      <%= render NexusCcs::MosaicComponent.new(tiles: discovery_tiles(@stories, text: ->(story) { [ story.summary, t("nexus_ccs.stories.published", date: l(story.date, format: "%-d %B %Y")) ].join(" ") }), label: t("nexus_ccs.stories.title"), lanes: 3) %>
    <% end %>
  </div>
</main>
