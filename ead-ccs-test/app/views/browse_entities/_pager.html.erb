<%# Between pages of a list: the site's pagination (the results page's Kaminari theme and components/pagination.css), as plain links (no JavaScript).
    page, pages: which page of how many; label: what the pages are of. Kaminari counts one "record" per page here. %>
<% if pages > 1 %>
  <%= tag.nav class: "paginate-section browse-pager", aria: { label: label } do %>
    <%= paginate Kaminari.paginate_array([], total_count: pages).page(page).per(1), theme: "blacklight", window: 2, outer_window: 1 %>
  <% end %>
<% end %>
