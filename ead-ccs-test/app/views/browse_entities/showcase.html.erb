<%# One place, maker, subject or period (BrowseEntitiesController#entity and #period), after Google Arts & Culture's place pages (looked at
    2026-11-23, described in our own words): a strip of its own pictures (each whole), its name and what it holds (a maker's dates and
    roles too); the collections that hold its records; its kinds of record and its centuries (a period: the decades within it), as picture tiles; "Discover",
    its records as the fluid mosaic; and what is related to it (places, makers, subjects), as picture tiles too. The facts and records are Browse::Profile's (records whose pictures or details
    need permission are left out of the mosaic; the count and the search include them). %>
<% result = @result %>
<% entry = @entry %>
<% period = @period %>
<% kind_key = entry&.kind&.key %>
<% name = entry ? entry.name : period.label %>
<% kind_label = entry ? entry.kind.singular : t("browse.place.period") %>
<% facts = kind_key == "makers" ? Browse::Creator.facts(entry, result.documents) : nil %>
<%# a maker's dates as the records give them (the commonest form) %>
<% life = kind_key == "makers" && result.documents.filter_map { |document| Browse::Meta.life_dates(document, entry.variants) }.tally.max_by(&:last)&.first %>
<% span = Browse::Meta.span_of(result) %>
<% region = kind_key == "places" ? PlaceRegions.region_of(name) : nil %>
<% kinds = Browse::NearDuplicates.reject(result.facets["object_type_ssim"]).first(10) %>
<% periods = result.periods.select { |_, count| count.positive? } %>
<% periods_heading = period ? t("browse.period.within") : t("browse.entity.related_periods") %>
<%# What is related: the places, makers and subjects of its records %>
<% related = [] %>
<% related << [ t("browse.entity.related_places"), "production_place_ssim", related_entities(Browse::Kind.find("places"), result.facets["production_place_ssim"], except: (entry if kind_key == "places")) ] %>
<% related << [ t("browse.entity.related_makers"), "creator_ssim", related_entities(Browse::Kind.find("makers"), result.facets["creator_ssim"], except: (entry if kind_key == "makers")) ] %>
<% related << [ t("browse.entity.related_subjects"), "subject_ssim", related_entities(Browse::Kind.find("subjects"), result.facets["subject_ssim"], except: (entry if kind_key == "subjects")) ] %>
<%# each value once: no spelling twice, not the page itself or its region, no subject that only names a place already shown %>
<% shown = [ name ] %>
<% related.each do |section| %>
  <% section[2] = Browse::NearDuplicates.reject(section[2], shown: shown, region: region) %>
  <% shown += section[2].map { |related_entry, _| related_entry.name } if section[1] == "production_place_ssim" %>
<% end %>
<% related.reject! { |_, _, pairs| pairs.empty? } %>
<%# every value the page shows, so those none of its own records carries get a picture of their records anywhere (one request) %>
<% @pictures.prepare(kinds.map { |value, _| [ "object_type_ssim", [ value ] ] } + periods.map(&:first) +
                     related.flat_map { |_, field, pairs| pairs.map { |related_entry, _| [ field, [ related_entry.name, *Array(related_entry.variants) ] ] } }) %>
<%# the tiles, worked out before anything is drawn, so the strip at the head takes only pictures nothing else on the page shows %>
<% kind_tiles = kinds.map { |value, _count| facet_tile(value, search_catalog_path(refine(@search_query, "object_type_ssim", value)), @pictures.value("object_type_ssim", value)) } %>
<% period_tiles = periods.map { |related_period, _count| facet_tile(related_period.label, related_period.path, @pictures.period(related_period)) } %>
<%# a related value's picture: a record with any of its spellings (Browse::Index::Entry#variants) %>
<% related = related.map { |heading, field, pairs| [ heading, pairs.map { |related_entry, _count| facet_tile(related_entry.name, related_entry.path, @pictures.value(field, related_entry.name, *Array(related_entry.variants))) } ] } %>
<%# the strip: the place's own pictures that neither "Discover" nor a tile shows (left out when there are fewer than three) %>
<% pictured = @pictures.spare(5) %>
<% advisory = result.cultural.positive? || name.match?(/aborigin|indigenous|torres strait|first nations|koori|palawa/i) %>
<% content_for :title, entry ? t("browse.entity.title", name: name, kind: kind_label) : t("browse.period.title", period: name) %>
<% content_for :body_class, "page-browse page-place page-browse-#{kind_key || 'period'}" %>

<main class="place-page" id="main-content">
  <% if pictured.size >= 3 %>
    <%# The place's own pictures, whole, in one justified row: decorative (each is one of its records, shown nowhere else on the page) %>
    <ul class="justified place-page__strip" data-controller="justified" aria-hidden="true">
      <% pictured.each do |document| %>
        <li class="justified__item"><%= image_tag AssetVersion.url(document.src), alt: "", class: "place-page__strip-image", decoding: "async" %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="place-page__inner">
    <header class="place-page__head">
      <p class="place-page__kind"><%= kind_label %><%= " #{t('browse.place.in_region', region: region)}" if region %><% if period&.parent %>, <%= link_to period.parent.label, period.parent.path %><% end %></p>
      <h1 class="place-page__title"><%= name %></h1>
      <%# no number of records or of collections (the site shows no counts): when its records were made, where that is known %>
      <%# the span of its records' dates, said as that (beside a maker's own life dates "Made 1816 to 2019" read as theirs); not on a
          period's page, whose title is its span already %>
      <% if span && entry %><p class="place-page__summary"><%= t("browse.place.records_dated", span: span) %></p><% end %>
      <% if facts&.any? || life %>
        <dl class="place-page__facts">
          <% if life %><div><dt><%= t("browse.entity.life_dates") %></dt><dd><%= life %></dd></div><% end %>
          <% if facts&.born %><div><dt><%= t("nexus_ccs.creator.born") %></dt><dd><%= facts.born %></dd></div><% end %>
          <% if facts&.died %><div><dt><%= t("nexus_ccs.creator.died") %></dt><dd><%= facts.died %></dd></div><% end %>
          <% if facts&.nationality %><div><dt><%= t("nexus_ccs.creator.nationality") %></dt><dd><%= facts.nationality %></dd></div><% end %>
          <% if facts&.roles.present? %><div><dt><%= t("nexus_ccs.creator.roles") %></dt><dd><%= Array(facts.roles).map(&:upcase_first).join(", ") %></dd></div><% end %>
        </dl>
      <% end %>
      <div class="place-page__actions">
        <%= link_to t("browse.entity.see_all"), search_catalog_path(@search_query), class: "btn btn-primary" %>
        <% hub = entry ? entry.kind.key : "periods" %>
        <%= link_to t("browse.place.all", hub: BrowseHubs.find(hub)&.title.to_s.downcase), BrowseHubs.find(hub).path, class: "arrow-link arrow-link--icon" %>
      </div>
    </header>

    <% if advisory %>
      <aside class="browse-advisory place-page__advisory" aria-labelledby="browse-advisory-title">
        <h2 id="browse-advisory-title" class="browse-advisory__title"><%= t("browse.entity.advisory_title") %></h2>
        <p><%= t("browse.entity.advisory") %> <%= link_to t("browse.entity.advisory_link"), "/help#indigenous" %></p>
      </aside>
    <% end %>

    <% if result.facets["collection_ssim"].any? %>
      <section class="place-section" aria-labelledby="place-collections">
        <h2 id="place-collections" class="place-section__heading"><%= t("browse.place.collections_heading") %></h2>
        <ul class="place-collections">
          <% result.facets["collection_ssim"].first(8).each do |name, _count| %>
            <% picture = collection_picture(name) %>
            <%# the collection's own page where it has one; otherwise its records from here in the search %>
            <% to = landing_path_for("collections", name) || search_catalog_path(refine(@search_query, "collection_ssim", name)) %>
            <li class="place-collections__item">
              <article class="result-card explore-card place-collection">
                <% if picture %><%= link_to to, class: "place-collection__media", tabindex: -1, "aria-hidden": true do %><%= image_tag AssetVersion.url(picture.path), alt: "", loading: "lazy", decoding: "async", width: picture.width, height: picture.height %><% end %><% end %>
                <div class="result-card__content">
                  <h3 class="document-title-heading"><%= link_to name, to, class: "explore-card__link" %></h3>
                </div>
              </article>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# Its kinds of record and its periods: picture tiles in the page's mosaic (a picture of one of each value's records), as every section;
        the periods in ordered lanes, so they read in time order %>
    <% if kinds.any? %>
      <section class="place-section" aria-labelledby="place-kinds">
        <h2 id="place-kinds" class="place-section__heading"><%= t("browse.entity.object_types") %></h2>
        <%= render "browse_entities/facet_tiles", tiles: kind_tiles, label: t("browse.entity.object_types"), ordered: false %>
      </section>
    <% end %>
    <% if periods.any? %>
      <section class="place-section" aria-labelledby="related-periods">
        <h2 id="related-periods" class="place-section__heading"><%= periods_heading %></h2>
        <%= render "browse_entities/facet_tiles", tiles: period_tiles, label: periods_heading, ordered: true %>
      </section>
    <% end %>

    <section class="place-section" aria-labelledby="place-discover">
      <div class="place-section__head">
        <h2 id="place-discover" class="place-section__heading"><%= t("browse.place.discover_#{kind_key || 'period'}", default: t("browse.place.discover")) %></h2>
        <% if result.pages > 1 %><p class="place-section__note"><%= t("browse.place.page", page: result.page, pages: result.pages) %></p><% end %>
      </div>
      <% if result.documents.empty? %>
        <p class="browse-empty"><%= t("browse.entity.empty_page") %></p>
      <% else %>
        <%= render NexusCcs::CardLayoutComponent.new(cards: result.documents, layout: :mosaic, lanes: 4, label: t("browse.place.discover"),
                                                     renderer: ->(document) { NexusCcs::RecordCardComponent.new(document: document) }) %>
      <% end %>
      <% if result.held_back.positive? %><p class="browse-note"><%= t("browse.entity.held_back") %></p><% end %>
      <%= render "browse_entities/pager", page: result.page, pages: result.pages, label: t("browse.entity.pagination") %>
    </section>

    <% related.each_with_index do |(heading, tiles), index| %>
      <section class="place-section" aria-labelledby="related-<%= index %>">
        <h2 id="related-<%= index %>" class="place-section__heading"><%= heading %></h2>
        <%= render "browse_entities/facet_tiles", tiles: tiles, label: heading, ordered: false %>
      </section>
    <% end %>
  </div>
</main>
