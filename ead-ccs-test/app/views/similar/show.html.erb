<%# The record page's Similar records section (SimilarController), the content of its lazy frame (NexusCcs::SimilarRecordsComponent) %>
<turbo-frame id="similar-records">
  <section class="similar-records" aria-labelledby="similar-records-heading">
    <div class="similar-records__inner">
      <h2 class="similar-records__heading" id="similar-records-heading"><%= t("nexus_ccs.similar.heading") %></h2>
      <p class="similar-records__description"><%= t("nexus_ccs.similar.description") %></p>
      <%= render "discover/cards", entries: @entries, title_tag: :h3 %>
    </div>
  </section>
</turbo-frame>
