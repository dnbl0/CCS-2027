<%# The record page's "Related objects" (approved split layout): computed similar records (SimilarRecords) as the site's result cards,
    three across, images whole and never cropped; every card has an image. %>
<turbo-frame id="similar-records" class="similar-frame" target="_top">
  <section class="record-related" id="related-objects" aria-labelledby="related-objects-heading" data-turbo="false">
    <div class="record-related__inner">
      <h2 class="record-band-heading" id="related-objects-heading"><%= t("nexus_ccs.record_page.split.related.heading") %></h2>
      <div class="record-more__cards"><%= render "discover/cards", entries: @entries.first(3), title_tag: :h3 %></div>
    </div>
  </section>
</turbo-frame>
