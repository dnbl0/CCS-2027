<%# locals: item, title, downloadable, request_path. Audio or video in a format web browsers cannot play (MediaTypes.browser_playable?:
    the DAM holds videos as WMV): a player would stay blank, so say so, and offer the file to download when its licence allows it
    (downloadable), else a request for a copy. Never the file's address for a file that may not be downloaded. %>
<% kind = item[:kind].to_s == "audio" ? t("nexus_ccs.media.unplayable.audio") : t("nexus_ccs.media.unplayable.video") %>
<% format = MediaTypes.format_name(item[:type], item[:url]) %>
<%# A DAM file often has only its file name for a title ("item395-processed.wmv"): the links then say "this video" (the caption below names the file) %>
<% name = title.to_s.match?(/\.[a-z0-9]{2,4}\z/i) ? t("nexus_ccs.media.unplayable.this", kind: kind) : title %>
<div class="digital-assets__unplayable">
  <p><%= t("nexus_ccs.media.unplayable.message", kind: kind, file_format: format) %></p>
  <% if downloadable %>
    <p><%= link_to t("nexus_ccs.media.unplayable.download", title: name, file_format: format), item[:url] %></p>
  <% elsif local_assigns[:request_path].present? %>
    <p><%= link_to t("nexus_ccs.media.unplayable.request", title: name), request_path %></p>
  <% end %>
</div>
<%= render "media_viewers/transcript", item: item, title: title %>
