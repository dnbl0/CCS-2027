<%# Every page under /browse (BrowseController#show, BrowseHubs), on the one template (browse/_template), after Google Arts & Culture's
    category pages (looked at 2026-11-25, described in our own words). A toolbar that stays in view: the search (live as you type; not for
    time or colours, whose lists are short), the views as tabs (browse/_views: All, a mosaic of the values with the most pictured records,
    each picture whole with its name under it; A–Z, every value by letter, or the periods in order; and time's, places' and colours'
    explorer), the regions (places only). The search
    stays outside the results frame so it keeps its focus while the results change; the views, regions, letters and results are one Turbo
    frame, updated without a reload and with the address kept (places_search_controller.js). Without JavaScript every link and the form
    load the page as usual. %>
<% kind = @hub.slug %>
<% places = kind == "places" %>
<% periods = @list.periods? %>
<% noun = @hub.title.downcase %>
<% state = { view: (@hub_view == :az ? "az" : nil), region: @list.region }.compact %>
<% first, last, size = @list.range %>
<% summary = if @hub_view == :all
     t("browse.hub.summary_all", count: @wall.size, noun: noun, singular: @hub.singular.downcase, region: (@list.region ? t("browse.places.in_region", region: @list.region) : ""))
   else
     t("browse.hub.summary", first: number_with_delimiter(first), last: number_with_delimiter(last), count: size, total: number_with_delimiter(size), noun: noun, singular: @hub.singular.downcase)
   end %>
<%# the search, in the template's toolbar (outside the results frame, so it keeps its focus while the results change) %>
<% content_for :browse_toolbar do %>
      <% unless periods || kind == "colours" %>
      <%= form_with url: @hub.path, method: :get, class: "places-search", data: { turbo_frame: "places-results", turbo_action: "advance", places_search_target: "form" },
                    html: { role: "search", "aria-label": t("browse.filter.label", kind: noun) } do |form| %>
        <%= form.label :filter, t("browse.hubs.#{kind}.search_label", default: t("browse.hub.search_label", singular: @hub.singular.downcase)), class: "places-search__label" %>
        <div class="places-search__row">
          <%= form.search_field :filter, value: @list.filter, id: "filter", class: "places-search__input form-control", autocomplete: "off", maxlength: 80,
                                placeholder: t("browse.hubs.#{kind}.placeholder", default: t("browse.hub.placeholder", singular: @hub.singular.downcase)), data: { action: "input->places-search#type", places_search_target: "input" } %>
          <%= hidden_field_tag :region, @list.region, id: nil, disabled: @list.region.blank?, data: { places_search_target: "region" } %>
          <%= form.button t("browse.filter.submit"), type: "submit", name: nil, class: "btn btn-primary places-search__submit" %>
        </div>
      <% end %>
      <% end %>
      <p class="visually-hidden" role="status" data-places-search-target="status"><%= summary %></p>
<% end %>
<%= render layout: "browse/template", locals: { hub: @hub, title: @hub.title, main: { data: { controller: "places-search" } } } do %>

    <turbo-frame id="places-results" data-places-search-target="frame" data-turbo-action="advance">
      <%# What the frame now shows, for the announcement and the search's region (Turbo replaces the frame's contents, not its attributes) %>
      <span hidden data-places-state data-summary="<%= summary %>" data-region="<%= @list.region %>"></span>
      <div class="places-nav">
        <%= render "browse/views", hub: @hub, view: @hub_view, region: @list.region, in_frame: true %>
      </div>

      <% if @list.regions.any? %>
        <nav class="places-regions" aria-label="<%= t("browse.places.regions") %>">
          <ul class="places-regions__list">
            <li><%= link_to t("browse.places.all_regions"), @hub.path(**state.except(:region), filter: @list.filter, letter: @list.letter), class: "places-chip", "aria-current": (@list.region ? nil : "true") %></li>
            <% @list.regions.each do |name, count| %>
              <li><%= link_to @hub.path(**state, region: name, filter: @list.filter, letter: @list.letter), class: "places-chip", "aria-current": (@list.region == name ? "true" : nil) do %><%= name %> <span class="places-chip__count"><%= number_with_delimiter(count) %></span><% end %></li>
            <% end %>
          </ul>
        </nav>
      <% end %>

      <% if @hub_view == :all %>
        <h2 class="places-page__heading"><%= @list.region ? t("browse.places.region_heading", region: @list.region) : (periods ? t("browse.hub.periods_heading") : t("browse.hub.all_heading", noun: @hub.title)) %></h2>
        <% if @wall.any? %>
          <%= render NexusCcs::MosaicComponent.new(tiles: @wall.map { |card| hub_tile(card, @list) }, label: t("browse.hub.all_heading", noun: @hub.title), lanes: (periods ? 4 : 6)) %>
        <% else %>
          <p class="browse-empty"><%= t("browse.hub.no_pictures", noun: noun) %></p>
        <% end %>
        <p class="places-page__more"><%= link_to t(periods ? "browse.hub.every_period" : "browse.hub.every", noun: noun, singular: @hub.singular.downcase, count: number_with_delimiter(@list.region ? @list.range.last : @list.total)), @hub.path(view: "az", region: @list.region), class: "arrow-link arrow-link--icon" %></p>
      <% else %>
        <% if @list.letters.any? %>
        <nav class="places-letters" aria-label="<%= t("browse.hub.letters", noun: noun) %>">
          <ul class="places-letters__list">
            <li><%= link_to t("browse.places.most"), @hub.path(view: "az", region: @list.region), class: "places-letters__link", "aria-current": (@list.letter || @list.filter ? nil : "page") %></li>
            <% @list.letters.each do |letter| %>
              <li><%= link_to letter, @hub.path(letter: letter, region: @list.region), class: "places-letters__link", "aria-current": (@list.letter == letter ? "page" : nil) %></li>
            <% end %>
          </ul>
        </nav>
        <% end %>
        <div class="places-list__head">
          <h2 class="places-page__heading"><%= @list.heading %></h2>
          <% if size.positive? && !periods %><p class="places-list__summary"><%= summary %></p><% end %>
        </div>
        <% if (@list.filter || @list.region) && @list.chosen.empty? %>
          <p class="browse-empty"><%= t("browse.hub.none", singular: @hub.singular.downcase, filter: @list.filter.presence || @list.region) %> <%= link_to t("browse.filter.clear"), @hub.path(view: "az") %></p>
        <% end %>
        <ul class="places-list">
          <% @list.entries.each do |entry| %>
            <li><%= link_to (entry.path || search_action_path(entry.query)), class: "places-list__link", data: { turbo_frame: "_top" } do %><span class="places-list__name"><%= entry.label.to_s.upcase_first %></span> <span class="places-list__count"><%= t("home.records", count: entry.count, number: number_with_delimiter(entry.count)) %></span><% end %></li>
          <% end %>
        </ul>
        <%= render "browse_entities/pager", page: @list.page, pages: @list.pages, label: t("browse.pagination", kind: noun) if @list.paged? %>
      <% end %>
    </turbo-frame>
<% end %>
