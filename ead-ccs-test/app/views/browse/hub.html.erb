<%# /browse/creators (places, subjects): an A to Z list with a type-to-filter box (a GET form, so it works without JavaScript). %>
<% title = @page.letter ? t("browse.hub.title_letter", kind: @kind.plural, letter: @page.letter) : t("browse.hub.title", kind: @kind.plural) %>
<% content_for :title, title %>
<% content_for :body_class, "page-browse" %>
<%= render NexusCcs::PageBannerComponent.new(title: @kind.plural, description: @kind.blurb) %>

<main class="browse-main" id="main-content">
  <div class="browse-main__inner">
    <%= form_with url: browse_kind_path(@kind.key), method: :get, class: "browse-filter", html: { role: "search", "aria-label": t("browse.filter.label", kind: @kind.plural.downcase) } do |form| %>
      <%= form.label :filter, t("browse.filter.label", kind: @kind.plural.downcase), class: "browse-filter__label" %>
      <p class="browse-filter__hint" id="browse-filter-hint"><%= t("browse.kinds.#{@kind.key}.filter_hint") %></p>
      <div class="browse-filter__row">
        <%= form.search_field :filter, value: @page.filter, id: "filter", class: "browse-filter__input", autocomplete: "off", maxlength: 80, "aria-describedby": "browse-filter-hint" %>
        <%= form.button t("browse.filter.submit"), type: "submit", class: "btn btn-primary" %>
        <% if @page.filter || @page.letter %>
          <%= link_to t("browse.filter.clear"), browse_kind_path(@kind.key), class: "browse-filter__clear" %>
        <% end %>
      </div>
    <% end %>

    <nav class="browse-letters" aria-label="<%= t('browse.letter_nav') %>">
      <h2 class="browse-letters__heading"><%= t("browse.a_to_z") %></h2>
      <ul>
        <li><%= link_to t("browse.all_letters"), browse_kind_path(@kind.key, filter: @page.filter), aria: { current: (@page.letter ? nil : "true") } %></li>
        <% Browse::Index::LETTERS.each do |letter| %>
          <% if @page.letter_counts[letter] %>
            <li><%= link_to letter, browse_kind_path(@kind.key, letter: letter, filter: @page.filter), aria: { current: (@page.letter == letter ? "true" : nil), label: "#{letter}, #{t('browse.filter.summary', count: @page.letter_counts[letter])}" } %></li>
          <% else %>
            <li><span class="browse-letters__none" aria-hidden="true"><%= letter %></span></li>
          <% end %>
        <% end %>
      </ul>
    </nav>

    <h2 class="browse-count"><%= t("browse.hub.count", count: number_with_delimiter(@page.total), kind: @kind.plural.downcase) %><%= " — #{@page.letter}" if @page.letter %></h2>
    <% if @page.entries.empty? %>
      <p class="browse-empty"><%= t("browse.filter.none", filter: @page.filter) %></p>
    <% else %>
      <%= render "browse/entity_list", entries: @page.entries %>
      <%= render "browse/pager", page: @page.page, pages: @page.pages, label: t("browse.pagination", kind: @kind.plural.downcase) %>
    <% end %>
  </div>
</main>
