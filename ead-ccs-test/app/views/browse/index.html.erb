<%# The Browse page, on the Browse list template (browse/hub): the centred head, the timeline and the map, then a section for each way in
    (object types, places, periods, makers, subjects), each its eight cards (Browse::Cards) as the fluid mosaic, with "See all" %>
<% content_for :body_class, "page-browse page-places" %>
<% content_for :title, "Browse the collections — Collections Navigator — University of Melbourne" %>
<%= render NexusCcs::PageBreadcrumbsComponent.new(trail: [ [ "Browse", nil ] ]) %>
<main class="places-page" id="main-content">
  <div class="places-page__inner">
    <%= render "browse/page_head", title: "Browse the collections", intro: "No search term needed. Start from what the records are, where they come from, when they were made, who made them or what they are about." %>
    <nav class="places-nav places-nav--centred" aria-label="<%= t("explore_pages.links_label") %>">
      <div class="places-views">
        <%= link_to t("explore_pages.time.title"), explore_time_path, class: "places-views__link" %>
        <%= link_to t("explore_pages.places.title"), explore_places_path, class: "places-views__link" %>
      </div>
    </nav>
    <% @sections.each do |hub, cards| %>
      <%= render NexusCcs::HomeSectionComponent.new(id: "browse-#{hub.slug}", heading: hub.title, intro: hub.intro,
                                                    link: t("browse.cards.see_all", kind: hub.title.downcase), link_path: browse_hub_path(hub.slug), extra_class: "browse-section browse-#{hub.slug}") do %>
        <%= render NexusCcs::CardLayoutComponent.new(cards: cards, layout: :mosaic, lanes: 4, label: hub.title) %>
      <% end %>
    <% end %>
  </div>
</main>
