<% content_for :body_class, "page-browse" %>
<% content_for :title, "Browse the collections — Collections Navigator — University of Melbourne" %>
<%= render NexusCcs::PageBreadcrumbsComponent.new(trail: [ [ "Browse", nil ] ]) %>
<%= render NexusCcs::PageBannerComponent.new(title: "Browse the collections", description: "No search term needed. Start from what the records are, where they come from, when they were made, who made them or what they are about.") %>
<main class="browse browse--hubs" id="main-content">
  <%# One section for each way in: its name, a link to every value, and eight cards in a layout of their own (Browse::Cards) %>
  <% @sections.each do |hub, cards| %>
    <%= render NexusCcs::CardSectionComponent.new(slug: hub.slug, prefix: "browse", heading: hub.title, intro: hub.intro,
                                                  see_all: t("browse.cards.see_all", kind: hub.title.downcase), see_all_path: browse_hub_path(hub.slug)) do %>
      <% if cards.any? %>
        <%= render NexusCcs::CardLayoutComponent.new(cards: cards, layout: Browse::Cards::LAYOUT_BY_HUB.fetch(hub.slug), label: hub.title,
                                                     panel: { title: t("browse.cards.panel_title", kind: hub.title.downcase), text: t("browse.cards.panel_text", kind: hub.title.downcase), link: t("browse.cards.see_all", kind: hub.title.downcase), path: browse_hub_path(hub.slug) }) %>
      <% end %>
    <% end %>
  <% end %>
</main>
