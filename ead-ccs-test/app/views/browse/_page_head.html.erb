<%# The centred head of every Browse list page (browse/_template) and of /browse itself: the title and its line of introduction; the one copy %>
<%# a div, not a header: outside main (the timeline, the map) a header would be a second banner landmark %>
<div class="places-page__head">
  <h1 class="places-page__title"><%= title %></h1>
  <% if local_assigns[:intro].present? %><p class="places-page__intro"><%= intro %></p><% end %>
</div>
