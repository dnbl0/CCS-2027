<%# A list of entities (Browse::Index::Entry) with their record counts, as links to their pages. %>
<ul class="browse-list">
  <% entries.each do |entry| %>
    <li><%= link_to entry.name, entry.path, class: "browse-list__link" %> <span class="browse-list__count"><%= t("browse.records", count: entry.count) %></span></li>
  <% end %>
</ul>
