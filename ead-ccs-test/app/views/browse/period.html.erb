<%# One century or decade (Browse::Period): see _profile. %>
<% content_for :title, t("browse.period.title", period: @period.label) %>
<% content_for :body_class, "page-browse page-browse-entity" %>
<%= render NexusCcs::PageBannerComponent.new(title: @period.label, description: (@period.kind == :century && @period.first >= 1000 ? @period.span : t("browse.time.plural"))) %>
<%= render "browse/profile", name: @period.label, total: @result.total, entry: nil, period: @period %>
